@page "/"
@implements IAsyncDisposable
@inject DroneApiService Drone

<PageTitle>Drone Control</PageTitle>

<div class="drone-shell">
    <header class="drone-header">
        <div>
            <p class="eyebrow">ArduCopter SITL</p>
            <h1>Drone Control</h1>
        </div>
        <div class="connection-state @(isConnected ? "online" : "offline")">
            <span></span>
            @(isConnected ? "Connected" : "Disconnected")
        </div>
    </header>

    <section class="control-grid">
        <div class="panel">
            <div class="panel-heading">
                <h2>Connection</h2>
                <button class="ghost-button" type="button" @onclick="RefreshStatus">Status</button>
            </div>

            <label for="connectionString">MAVLink endpoint</label>
            <input id="connectionString" @bind="connectionString" @bind:event="oninput" placeholder="udpin:0.0.0.0:14551" />

            <div class="inline-fields">
                <label>
                    Baud
                    <input type="number" @bind="baudRate" min="1" />
                </label>
                <label>
                    Timeout
                    <input type="number" @bind="heartbeat" min="0.1" max="60" step="0.1" />
                </label>
            </div>

            <div class="button-row">
                <button class="primary-button" type="button" @onclick="ConnectAsync" disabled="@isBusy">Connect</button>
                <button type="button" @onclick="DisconnectAsync" disabled="@isBusy">Disconnect</button>
            </div>

            @if (HasPanelMessage("connection"))
            {
                <div class="@PanelMessageClass">
                    <strong>@status</strong>
                    @if (!string.IsNullOrWhiteSpace(error))
                    {
                        <pre>@error</pre>
                    }
                    @if (!string.IsNullOrWhiteSpace(response))
                    {
                        <pre>@response</pre>
                    }
                </div>
            }
        </div>

        <div class="panel">
            <div class="panel-heading">
                <h2>Flight</h2>
            </div>

            <div class="inline-fields">
                <label>
                    Mode
                    <select @bind="selectedMode">
                        <option>STABILIZE</option>
                        <option>ALT_HOLD</option>
                        <option>GUIDED</option>
                        <option>LOITER</option>
                        <option>LAND</option>
                    </select>
                </label>
                <label>
                    Takeoff height
                    <input type="number" @bind="takeoffAltitudeMeters" min="1" max="50" step="0.5" />
                </label>
            </div>

            <label class="checkbox-label">
                <input type="checkbox" @bind="armBeforeTakeoff" />
                Arm first
            </label>

            <div class="button-row">
                <button type="button" @onclick="SetModeAsync" disabled="@isBusy">Set Mode</button>
                <button type="button" @onclick="ArmAsync" disabled="@isBusy">Arm</button>
                <button type="button" @onclick="DisarmAsync" disabled="@isBusy">Disarm</button>
                <button class="primary-button" type="button" @onclick="TakeoffAsync" disabled="@isBusy">Takeoff</button>
                <button class="danger-button" type="button" @onclick="LandAsync" disabled="@isBusy">Land</button>
            </div>

            @if (HasPanelMessage("flight"))
            {
                <div class="@PanelMessageClass">
                    <strong>@status</strong>
                    @if (!string.IsNullOrWhiteSpace(error))
                    {
                        <pre>@error</pre>
                    }
                    @if (!string.IsNullOrWhiteSpace(response))
                    {
                        <pre>@response</pre>
                    }
                </div>
            }
        </div>

        <div class="panel wide-panel">
            <div class="panel-heading">
                <h2>Live Control</h2>
                <div class="stick-state @(isJoystickStreaming ? "active" : "")">
                    <span></span>
                    @(isJoystickStreaming ? "Stick active" : "Stick idle")
                </div>
            </div>

            <div class="inline-fields">
                <label>
                    Strength
                    <input type="number" @bind="controlStrength" min="0.05" max="1" step="0.05" />
                </label>
            </div>

            <div class="flight-deck" tabindex="0" @onkeydown="HandleControlKeyDown" @onkeydown:preventDefault="true">
                <div class="deck-topbar">
                    <div>
                        <p class="eyebrow">STABILIZE RC override</p>
                        <strong>Virtual receiver input</strong>
                    </div>
                    <div class="pwm-strip">
                        <span>Roll <strong>@RollPwm</strong></span>
                        <span>Pitch <strong>@PitchPwm</strong></span>
                        <span>Thr <strong>@ThrottlePwm</strong></span>
                        <span>Yaw <strong>1500</strong></span>
                    </div>
                </div>

                <div class="stick-stage">
                    <div class="stick-dial throttle-stick" style="@ThrottleStickStyle">
                        <div class="stick-ring"></div>
                        <div class="stick-cross"></div>
                        <div class="stick-knob"></div>
                        <span class="stick-label">Throttle</span>
                    </div>
                    <div class="stick-dial attitude-stick" style="@AttitudeStickStyle">
                        <div class="stick-ring"></div>
                        <div class="stick-cross"></div>
                        <div class="stick-knob"></div>
                        <span class="stick-label">Pitch / Roll</span>
                    </div>
                </div>

                <div class="keyboard-control">
                    <div class="key-grid">
                        <kbd>W</kbd><span>Forward +</span>
                        <kbd>S</kbd><span>Forward -</span>
                        <kbd>A</kbd><span>Left +</span>
                        <kbd>D</kbd><span>Right +</span>
                        <kbd>P</kbd><span>Throttle +</span>
                        <kbd>L</kbd><span>Throttle -</span>
                    </div>
                    <div class="button-row">
                        <button class="primary-button" type="button" @onclick="StartStabilizeStickAsync" disabled="@(isBusy || isJoystickStreaming)">STABILIZE + Stick</button>
                        <button class="stop-button" type="button" @onclick="StopVirtualJoystickStreamAsync" disabled="@isBusy">Center / Stop</button>
                    </div>
                </div>

                <div class="joystick-sliders">
                    <label>
                        Forward / Back
                        <input type="range" @bind="joystickForward" @bind:event="oninput" min="-1" max="1" step="0.05" />
                        <output>@joystickForward.ToString("0.00")</output>
                    </label>
                    <label>
                        Left / Right
                        <input type="range" @bind="joystickRight" @bind:event="oninput" min="-1" max="1" step="0.05" />
                        <output>@joystickRight.ToString("0.00")</output>
                    </label>
                    <label>
                        Throttle
                        <input type="range" @bind="joystickThrottle" @bind:event="oninput" min="-1" max="1" step="0.05" />
                        <output>@joystickThrottle.ToString("0.00")</output>
                    </label>
                </div>

                @if (HasPanelMessage("live"))
                {
                    <div class="@PanelMessageClass">
                        <strong>@status</strong>
                        @if (!string.IsNullOrWhiteSpace(error))
                        {
                            <pre>@error</pre>
                        }
                        @if (!string.IsNullOrWhiteSpace(response))
                        {
                            <pre>@response</pre>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="panel wide-panel">
            <div class="panel-heading">
                <h2>MAVLink Console</h2>
            </div>

            <label for="rawCommandText">Raw command</label>
            <textarea id="rawCommandText" @bind="rawCommandText" @bind:event="oninput" rows="4" spellcheck="false"></textarea>

            <div class="button-row">
                <button type="button" @onclick='() => SetRawCommandExample("command_long 22 0 0 0 0 0 0 5")'>Takeoff 5m</button>
                <button type="button" @onclick='() => SetRawCommandExample("command_long 400 1 0 0 0 0 0 0")'>Arm</button>
                <button type="button" @onclick='() => SetRawCommandExample("command_long 400 0 0 0 0 0 0 0")'>Disarm</button>
            </div>

            <button class="primary-button" type="button" @onclick="SendRawCommandAsync" disabled="@isBusy">Send Command</button>

            @if (HasPanelMessage("raw"))
            {
                <div class="@PanelMessageClass">
                    <strong>@status</strong>
                    @if (!string.IsNullOrWhiteSpace(error))
                    {
                        <pre>@error</pre>
                    }
                    @if (!string.IsNullOrWhiteSpace(response))
                    {
                        <pre>@response</pre>
                    }
                </div>
            }
        </div>
    </section>

    <section class="telemetry-band">
        <div>
            <p class="eyebrow">Telemetry</p>
            <strong>Vehicle status</strong>
        </div>

        @if (!string.IsNullOrWhiteSpace(statusJson))
        {
            <pre>@statusJson</pre>
        }
    </section>
</div>

@code {
    private readonly CancellationTokenSource statusCancellation = new();

    private string status = "Ready";
    private string error = "";
    private string response = "";
    private string statusJson = "";
    private string activeStatusArea = "";
    private string rawCommandText = "command_long 22 0 0 0 0 0 0 5";
    private bool isBusy;
    private bool isConnected;

    private string connectionString = "udpin:0.0.0.0:14551";
    private int baudRate = 57600;
    private double heartbeat = 10.0;

    private string selectedMode = "STABILIZE";
    private double takeoffAltitudeMeters = 5.0;
    private bool armBeforeTakeoff = true;

    private double controlStrength = 0.45;
    private double keyboardStep = 0.05;
    private double joystickForward;
    private double joystickRight;
    private double joystickThrottle;
    private bool isJoystickStreaming;
    private CancellationTokenSource? joystickCancellation;

    private int RollPwm => AxisToPwm(joystickRight);
    private int PitchPwm => AxisToPwm(joystickForward);
    private int ThrottlePwm => AxisToPwm(joystickThrottle);
    private string AttitudeStickStyle => StickStyle(joystickRight, joystickForward);
    private string ThrottleStickStyle => StickStyle(0, joystickThrottle);
    private string PanelMessageClass => string.IsNullOrWhiteSpace(error) ? "panel-message" : "panel-message error-message";

    protected override void OnInitialized()
    {
        _ = PollStatusAsync(statusCancellation.Token);
    }

    private async Task Handle(string area, string name, Func<Task<DroneApiService.ApiResponse<object>>> action)
    {
        activeStatusArea = area;
        error = "";
        response = "";
        status = $"{name}...";
        isBusy = true;

        try
        {
            var result = await action();

            if (result.Success)
            {
                status = $"{name} OK";
                response = result.ResponseBody ?? "";
                await RefreshStatus(showErrors: false);
            }
            else
            {
                status = $"{name} failed";
                error = CombineError(result.ErrorMessage, result.ResponseBody);
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private Task ConnectAsync()
    {
        var trimmedConnectionString = connectionString.Trim();

        if (string.IsNullOrWhiteSpace(trimmedConnectionString))
        {
            status = "Connect blocked";
            error = "Enter a MAVLink endpoint such as udpin:0.0.0.0:14551 or tcp:127.0.0.1:5763.";
            response = "";
            activeStatusArea = "connection";
            isConnected = false;
            return Task.CompletedTask;
        }

        return Handle("connection", "Connect", async () =>
        {
            var result = await Drone.Connect(trimmedConnectionString, baudRate, heartbeat);
            isConnected = result.Success;
            return result;
        });
    }

    private Task DisconnectAsync()
    {
        return Handle("connection", "Disconnect", async () =>
        {
            var result = await Drone.Disconnect();
            isConnected = false;
            statusJson = "";
            return result;
        });
    }

    private Task SetModeAsync() => Handle("flight", "Set mode", () => Drone.SetMode(selectedMode));
    private Task ArmAsync() => Handle("flight", "Arm", Drone.Arm);
    private Task DisarmAsync() => Handle("flight", "Disarm", Drone.Disarm);
    private Task TakeoffAsync() => Handle("flight", "Takeoff 5m", () => Drone.Takeoff(takeoffAltitudeMeters, armBeforeTakeoff));
    private Task LandAsync() => Handle("flight", "Land", Drone.Land);

    private void HandleControlKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key.ToLowerInvariant())
        {
            case "w":
                joystickForward = AdjustAxis(joystickForward, keyboardStep);
                break;
            case "s":
                joystickForward = AdjustAxis(joystickForward, -keyboardStep);
                break;
            case "a":
                joystickRight = AdjustAxis(joystickRight, -keyboardStep);
                break;
            case "d":
                joystickRight = AdjustAxis(joystickRight, keyboardStep);
                break;
            case "p":
                joystickThrottle = AdjustAxis(joystickThrottle, keyboardStep);
                break;
            case "l":
                joystickThrottle = AdjustAxis(joystickThrottle, -keyboardStep);
                break;
        }
    }

    private static double AdjustAxis(double current, double delta)
    {
        return Math.Round(Math.Clamp(current + delta, -1.0, 1.0), 2);
    }

    private static int AxisToPwm(double value)
    {
        return (int)Math.Round(1500 + (Math.Clamp(value, -1.0, 1.0) * 500));
    }

    private static string StickStyle(double x, double y)
    {
        var left = 50 + (Math.Clamp(x, -1.0, 1.0) * 42);
        var top = 50 - (Math.Clamp(y, -1.0, 1.0) * 42);

        return FormattableString.Invariant($"--stick-x:{left:0.##}%;--stick-y:{top:0.##}%;");
    }

    private bool HasPanelMessage(string area)
    {
        return string.Equals(activeStatusArea, area, StringComparison.Ordinal)
            && (!string.IsNullOrWhiteSpace(status)
                || !string.IsNullOrWhiteSpace(error)
                || !string.IsNullOrWhiteSpace(response));
    }

    private async Task StartStabilizeStickAsync()
    {
        selectedMode = "STABILIZE";
        await Handle("live", "Set STABILIZE", () => Drone.SetMode("STABILIZE"));

        if (string.IsNullOrWhiteSpace(error))
        {
            await StartVirtualJoystickStreamAsync();
        }
    }

    private Task StartVirtualJoystickStreamAsync()
    {
        if (isJoystickStreaming)
        {
            return Task.CompletedTask;
        }

        joystickCancellation = new CancellationTokenSource();
        isJoystickStreaming = true;
        activeStatusArea = "live";
        error = "";
        response = "";
        status = "Virtual joystick streaming";
        _ = StreamVirtualJoystickAsync(joystickCancellation.Token);
        return Task.CompletedTask;
    }

    private async Task StopVirtualJoystickStreamAsync()
    {
        joystickCancellation?.Cancel();
        joystickCancellation?.Dispose();
        joystickCancellation = null;
        isJoystickStreaming = false;
        joystickForward = 0;
        joystickRight = 0;
        joystickThrottle = 0;
        await Handle("live", "Virtual joystick center", () => Drone.SendVirtualJoystick(0, 0, 0, 0, 0.1));
    }

    private async Task StreamVirtualJoystickAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));

            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var result = await Drone.SendVirtualJoystick(
                    Math.Clamp(joystickForward * controlStrength, -1.0, 1.0),
                    Math.Clamp(joystickRight * controlStrength, -1.0, 1.0),
                    Math.Clamp(joystickThrottle, -1.0, 1.0),
                    0,
                    0);

                if (!result.Success)
                {
                    activeStatusArea = "live";
                    status = "Virtual joystick failed";
                    error = CombineError(result.ErrorMessage, result.ResponseBody);
                    isJoystickStreaming = false;
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            isJoystickStreaming = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task SendRawCommandAsync()
    {
        if (!TryParseRawCommand(rawCommandText, out var commandId, out var parameters, out var parseError))
        {
            activeStatusArea = "raw";
            status = "Raw command blocked";
            error = parseError;
            response = "";
            return Task.CompletedTask;
        }

        return Handle("raw", "Raw command", () => Drone.RawCommand(
            commandId,
            parameters[0],
            parameters[1],
            parameters[2],
            parameters[3],
            parameters[4],
            parameters[5],
            parameters[6]));
    }

    private void SetRawCommandExample(string command)
    {
        rawCommandText = command;
    }

    private static bool TryParseRawCommand(
        string input,
        out int commandId,
        out double[] parameters,
        out string errorMessage)
    {
        commandId = 0;
        parameters = new double[7];
        errorMessage = "";

        var tokens = input
            .Split(new[] { ' ', '\r', '\n', '\t', ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
            .ToList();

        if (tokens.Count > 0 && IsCommandLongAlias(tokens[0]))
        {
            tokens.RemoveAt(0);
        }

        if (tokens.Count == 0)
        {
            errorMessage = "Gib z.B. ein: command_long 22 0 0 0 0 0 0 5";
            return false;
        }

        if (!int.TryParse(tokens[0], out commandId) || commandId <= 0)
        {
            errorMessage = "Der erste Wert muss eine MAVLink command_id groesser als 0 sein.";
            return false;
        }

        for (var index = 1; index < tokens.Count && index <= 7; index++)
        {
            if (!TryParseDouble(tokens[index], out parameters[index - 1]))
            {
                errorMessage = $"Parameter {index} ist keine Zahl: {tokens[index]}";
                return false;
            }
        }

        return true;
    }

    private static bool IsCommandLongAlias(string token)
    {
        return string.Equals(token, "command_long", StringComparison.OrdinalIgnoreCase)
            || string.Equals(token, "cmd_long", StringComparison.OrdinalIgnoreCase)
            || string.Equals(token, "command", StringComparison.OrdinalIgnoreCase)
            || string.Equals(token, "cmd", StringComparison.OrdinalIgnoreCase);
    }

    private static bool TryParseDouble(string value, out double parsed)
    {
        return double.TryParse(
                value,
                System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture,
                out parsed)
            || double.TryParse(value, out parsed);
    }

    private async Task RefreshStatus()
    {
        activeStatusArea = "connection";
        error = "";
        response = "";
        status = "Status...";
        await RefreshStatus(showErrors: true);

        if (string.IsNullOrWhiteSpace(error))
        {
            status = "Status OK";
        }
    }

    private async Task RefreshStatus(bool showErrors)
    {
        try
        {
            statusJson = await Drone.GetStatus();
            isConnected = statusJson.Contains("\"connected\":true", StringComparison.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            if (showErrors)
            {
                status = "Status failed";
                error = ex.Message;
            }
        }
    }

    private async Task PollStatusAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (!isConnected)
                {
                    continue;
                }

                await RefreshStatus(showErrors: false);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private static string CombineError(string? message, string? body)
    {
        if (string.IsNullOrWhiteSpace(body))
        {
            return message ?? "Unknown error";
        }

        if (string.IsNullOrWhiteSpace(message))
        {
            return body;
        }

        return $"{message}{Environment.NewLine}{body}";
    }

    public ValueTask DisposeAsync()
    {
        joystickCancellation?.Cancel();
        joystickCancellation?.Dispose();
        statusCancellation.Cancel();
        statusCancellation.Dispose();
        return ValueTask.CompletedTask;
    }
}

<style>
    :root {
        color-scheme: dark;
    }

    body {
        background: #101418;
        color: #e8edf2;
    }

    .drone-shell {
        display: flex;
        flex-direction: column;
        gap: 20px;
        max-width: 1180px;
        margin: 0 auto;
        padding: 22px 0 36px;
    }

    .drone-header,
    .telemetry-band,
    .panel {
        border: 1px solid #2b3540;
        background: #171d23;
        border-radius: 8px;
    }

    .drone-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 20px;
    }

    .eyebrow {
        margin: 0 0 4px;
        color: #9fb1c1;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0;
    }

    h1,
    h2 {
        margin: 0;
        letter-spacing: 0;
    }

    h1 {
        font-size: 2rem;
    }

    h2 {
        font-size: 1rem;
    }

    .connection-state {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-width: 132px;
        justify-content: center;
        padding: 8px 10px;
        border: 1px solid #34404c;
        border-radius: 6px;
        color: #b7c5d1;
        font-weight: 700;
    }

    .connection-state span {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: #db5c5c;
    }

    .connection-state.online span {
        background: #4cc27a;
    }

    .control-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .panel {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 16px;
    }

    .wide-panel {
        grid-column: span 2;
    }

    .panel-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    label {
        display: flex;
        flex-direction: column;
        gap: 6px;
        color: #b7c5d1;
        font-size: 0.85rem;
        font-weight: 700;
    }

    input,
    select,
    textarea {
        width: 100%;
        min-height: 40px;
        padding: 8px 10px;
        border: 1px solid #34404c;
        border-radius: 6px;
        background: #0f1419;
        color: #f4f7fa;
        font: inherit;
    }

    textarea {
        min-height: 112px;
        resize: vertical;
    }

    .inline-fields,
    .button-row {
        display: grid;
        gap: 10px;
    }

    .inline-fields {
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    }

    .button-row {
        grid-template-columns: repeat(auto-fit, minmax(118px, 1fr));
    }

    .stick-state {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-width: 118px;
        justify-content: center;
        padding: 7px 10px;
        border: 1px solid #34404c;
        border-radius: 999px;
        color: #b7c5d1;
        font-size: 0.78rem;
        font-weight: 800;
    }

    .stick-state span {
        width: 9px;
        height: 9px;
        border-radius: 999px;
        background: #75511b;
    }

    .stick-state.active span {
        background: #4cc27a;
    }

    .flight-deck {
        display: grid;
        gap: 14px;
        min-height: 360px;
        padding: 14px;
        border: 1px solid #2d3c47;
        border-radius: 8px;
        outline: none;
        background:
            linear-gradient(90deg, rgba(12, 17, 21, 0.92), rgba(12, 17, 21, 0.45), rgba(12, 17, 21, 0.92)),
            radial-gradient(circle at 18% 35%, rgba(92, 126, 100, 0.62), transparent 22%),
            radial-gradient(circle at 78% 28%, rgba(125, 111, 86, 0.52), transparent 19%),
            repeating-linear-gradient(28deg, rgba(255, 255, 255, 0.08) 0 2px, transparent 2px 34px),
            repeating-linear-gradient(116deg, rgba(255, 255, 255, 0.05) 0 2px, transparent 2px 42px),
            #101418;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.03);
    }

    .flight-deck:focus {
        border-color: #2482ab;
        box-shadow: 0 0 0 2px rgba(36, 130, 171, 0.35), inset 0 0 0 1px rgba(255, 255, 255, 0.03);
    }

    .deck-topbar,
    .keyboard-control {
        display: grid;
        grid-template-columns: minmax(200px, 1fr) minmax(280px, 1.4fr);
        align-items: center;
        gap: 12px;
        padding: 12px;
        border: 1px solid rgba(92, 110, 124, 0.62);
