@page "/"
@implements IAsyncDisposable
@inject DroneApiService Drone

<PageTitle>Drone Control</PageTitle>

<div class="drone-shell">
    <header class="drone-header">
        <div>
            <p class="eyebrow">ArduCopter SITL / ESP32 MAVLink</p>
            <h1>Drone Control</h1>
        </div>
        <div class="connection-state @(isConnected ? "online" : "offline")">
            <span></span>
            @(isConnected ? "Connected" : "Disconnected")
        </div>
    </header>

    <div class="main-layout">
        <div class="content-area">
            <section class="control-grid">
                <div class="panel">
                    <div class="panel-heading">
                        <h2>Connection</h2>
                        <button class="ghost-button" type="button" @onclick="RefreshStatus">Status</button>
                    </div>

                    <label for="connectionString">MAVLink endpoint</label>
                    <input id="connectionString" @bind="connectionString" @bind:event="oninput" placeholder="udpin:0.0.0.0:14551" />

                    <div class="inline-fields">
                        <label>
                            Baud
                            <input type="number" @bind="baudRate" min="1" />
                        </label>
                        <label>
                            Timeout
                            <input type="number" @bind="heartbeat" min="0.1" max="60" step="0.1" />
                        </label>
                    </div>

                    <div class="button-row">
                        <button class="primary-button" type="button" @onclick="ConnectAsync" disabled="@isBusy">Connect</button>
                        <button type="button" @onclick="DisconnectAsync" disabled="@isBusy">Disconnect</button>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-heading">
                        <h2>Flight</h2>
                    </div>

                    <div class="inline-fields">
                        <label>
                            Mode
                            <select @bind="selectedMode">
                                <option>STABILIZE</option>
                                <option>ALT_HOLD</option>
                                <option>GUIDED</option>
                                <option>LOITER</option>
                                <option>LAND</option>
                            </select>
                        </label>
                        <label>
                            Takeoff height
                            <input type="number" @bind="takeoffAltitudeMeters" min="1" max="50" step="0.5" />
                        </label>
                    </div>

                    <label class="checkbox-label">
                        <input type="checkbox" @bind="armBeforeTakeoff" />
                        Arm first
                    </label>

                    <div class="button-row">
                        <button type="button" @onclick="SetModeAsync" disabled="@isBusy">Set Mode</button>
                        <button type="button" @onclick="ArmAsync" disabled="@isBusy">Arm</button>
                        <button type="button" @onclick="DisarmAsync" disabled="@isBusy">Disarm</button>
                        <button class="primary-button" type="button" @onclick="TakeoffAsync" disabled="@isBusy">Takeoff</button>
                        <button class="danger-button" type="button" @onclick="LandAsync" disabled="@isBusy">Land</button>
                    </div>
                </div>

                <div class="panel wide-panel">
                    <div class="panel-heading">
                        <h2>Live Control</h2>
                        <button class="stop-button" type="button" @onclick="StopAsync" disabled="@isBusy">Stop</button>
                    </div>

                    <div class="inline-fields">
                        <label>
                            Strength
                            <input type="number" @bind="controlStrength" min="0.05" max="1" step="0.05" />
                        </label>
                        <label>
                            Pulse
                            <input type="number" @bind="controlDuration" min="0" max="5" step="0.05" />
                        </label>
                        <label>
                            Yaw speed
                            <input type="number" @bind="yawSpeed" min="1" max="100" step="1" />
                        </label>
                    </div>

                    <div class="joystick-panel">
                        <div class="joystick-sliders">
                            <label>
                                Forward / Back
                                <input type="range" @bind="joystickForward" @bind:event="oninput" min="-1" max="1" step="0.05" />
                                <output>@joystickForward.ToString("0.00")</output>
                            </label>
                            <label>
                                Left / Right
                                <input type="range" @bind="joystickRight" @bind:event="oninput" min="-1" max="1" step="0.05" />
                                <output>@joystickRight.ToString("0.00")</output>
                            </label>
                            <label>
                                Throttle
                                <input type="range" @bind="joystickThrottle" @bind:event="oninput" min="-1" max="1" step="0.05" />
                                <output>@joystickThrottle.ToString("0.00")</output>
                            </label>
                            <label>
                                Yaw
                                <input type="range" @bind="joystickYaw" @bind:event="oninput" min="-1" max="1" step="0.05" />
                                <output>@joystickYaw.ToString("0.00")</output>
                            </label>
                        </div>

                        <div class="button-row">
                            <button class="primary-button" type="button" @onclick="StartVirtualJoystickStreamAsync" disabled="@(isBusy || isJoystickStreaming)">Start Stick Stream</button>
                            <button type="button" @onclick="SendVirtualJoystickAsync" disabled="@isBusy">Send Once</button>
                            <button class="stop-button" type="button" @onclick="StopVirtualJoystickStreamAsync" disabled="@isBusy">Center / Stop</button>
                        </div>
                    </div>

                    <div class="button-pad">
                        <button type="button" @onclick="MoveForwardAsync" disabled="@isBusy">Forward</button>
                        <button type="button" @onclick="MoveLeftAsync" disabled="@isBusy">Left</button>
                        <button class="stop-button" type="button" @onclick="StopAsync" disabled="@isBusy">Stop</button>
                        <button type="button" @onclick="MoveRightAsync" disabled="@isBusy">Right</button>
                        <button type="button" @onclick="MoveBackAsync" disabled="@isBusy">Back</button>
                    </div>

                    <div class="button-row">
                        <button type="button" @onclick="MoveUpAsync" disabled="@isBusy">Up</button>
                        <button type="button" @onclick="MoveDownAsync" disabled="@isBusy">Down</button>
                        <button type="button" @onclick="YawLeftAsync" disabled="@isBusy">Yaw Left</button>
                        <button type="button" @onclick="YawRightAsync" disabled="@isBusy">Yaw Right</button>
                    </div>

                    <div class="inline-fields">
                        <label>
                            Throttle PWM
                            <input type="number" @bind="throttlePwm" min="1000" max="2000" step="10" />
                        </label>
                        <label>
                            Duration
                            <input type="number" @bind="throttleDuration" min="0" max="30" step="0.1" />
                        </label>
                    </div>

                    <button type="button" @onclick="SendThrottleAsync" disabled="@isBusy">Send Throttle</button>
                </div>

                <div class="panel wide-panel">
                    <div class="panel-heading">
                        <h2>MAVLink Console</h2>
                    </div>

                    <label for="rawCommandText">Raw command</label>
                    <textarea id="rawCommandText" @bind="rawCommandText" @bind:event="oninput" rows="4" spellcheck="false"></textarea>

                    <div class="button-row">
                        <button type="button" @onclick='() => SetRawCommandExample("22 0 0 0 0 0 0 5")'>Takeoff 5m</button>
                        <button type="button" @onclick='() => SetRawCommandExample("400 1 0 0 0 0 0 0")'>Arm</button>
                        <button type="button" @onclick='() => SetRawCommandExample("400 0 0 0 0 0 0 0")'>Disarm</button>
                    </div>

                    <button class="primary-button" type="button" @onclick="SendRawCommandAsync" disabled="@isBusy">Send Command</button>
                </div>
            </section>

            <section class="telemetry-band">
                <div>
                    <p class="eyebrow">Last action</p>
                    <strong>@status</strong>
                </div>

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <pre class="error-output">@error</pre>
                }

                @if (!string.IsNullOrWhiteSpace(response))
                {
                    <pre>@response</pre>
                }
            </section>
        </div>

        <aside class="sensor-sidebar">
            <div class="sidebar-header">
                <h2>📡 MAVLink Inspector</h2>
                <button class="refresh-sensor-btn" @onclick="RefreshSensorData" disabled="@isBusy">⟳</button>
            </div>

            <div class="sensor-section instrument-section">
                <div class="section-title">Attitude</div>
                <div class="attitude-indicator" aria-label="Gyro level indicator">
                    <div class="attitude-window">
                        <div class="attitude-horizon" style="@GetAttitudeHorizonStyle()">
                            <div class="sky-band"></div>
                            <div class="ground-band"></div>
                            <div class="horizon-line"></div>
                            <div class="pitch-mark pitch-mark-up">+10</div>
                            <div class="pitch-mark pitch-mark-down">-10</div>
                        </div>
                        <div class="aircraft-symbol">
                            <span></span>
                            <strong></strong>
                            <span></span>
                        </div>
                        <div class="roll-scale">
                            <span class="roll-tick tick-left"></span>
                            <span class="roll-tick tick-center"></span>
                            <span class="roll-tick tick-right"></span>
                        </div>
                    </div>
                    <div class="instrument-readout">
                        <span>Roll rate <strong>@sensorData.GyroX.ToString("0.00")</strong></span>
                        <span>Pitch rate <strong>@sensorData.GyroY.ToString("0.00")</strong></span>
                    </div>
                </div>
            </div>

            <div class="sensor-section">
                <div class="section-title">📍 GPS</div>
                <div class="sensor-item">
                    <span class="sensor-label">Status:</span>
                    <span class="sensor-value @(sensorData.GpsFix >= 3 ? "text-success" : "text-warning")">@GetGpsFixText(sensorData.GpsFix)</span>
                </div>
                <div class="sensor-item">
                    <span class="sensor-label">Satellites:</span>
                    <span class="sensor-value">@sensorData.GpsSatellites</span>
                </div>
                <div class="sensor-item">
                    <span class="sensor-label">Latitude:</span>
                    <span class="sensor-value">@sensorData.Latitude.ToString("0.000000")</span>
                </div>
                <div class="sensor-item">
                    <span class="sensor-label">Longitude:</span>
                    <span class="sensor-value">@sensorData.Longitude.ToString("0.000000")</span>
                </div>
                <div class="sensor-item">
                    <span class="sensor-label">Altitude (MSL):</span>
                    <span class="sensor-value">@sensorData.GpsAltitude.ToString("0.0") m</span>
                </div>
                <div class="sensor-item">
                    <span class="sensor-label">Ground Speed:</span>
                    <span class="sensor-value">@sensorData.GroundSpeed.ToString("0.00") m/s</span>
                </div>
                <div class="sensor-item">
                    <span class="sensor-label">Heading:</span>
                    <span class="sensor-value">@sensorData.Cog.ToString("0")°</span>
                </div>
                <div class="sensor-item">
                    <span class="sensor-label">HDOP:</span>
                    <span class="sensor-value">@sensorData.Hdop.ToString("0.00")</span>
                </div>
            </div>

            <div class="sensor-section">
                <div class="section-title">📊 Altitude & Barometer</div>
                <div class="sensor-item">
                    <span class="sensor-label">Relative Alt:</span>
                    <span class="sensor-value">@sensorData.RelativeAlt.ToString("0.00") m</span>
                </div>
                <div class="sensor-item">
                    <span class="sensor-label">Absolute Alt:</span>
                    <span class="sensor-value">@sensorData.AbsoluteAlt.ToString("0.0") m</span>
                </div>
                <div class="sensor-item">
                    <span class="sensor-label">Pressure:</span>
                    <span class="sensor-value">@sensorData.Pressure.ToString("0.0") hPa</span>
                </div>
                <div class="sensor-item">
                    <span class="sensor-label">Temperature:</span>
                    <span class="sensor-value">@sensorData.Temperature.ToString("0.0") °C</span>
                </div>
            </div>

            <div class="sensor-section">
                <div class="section-title">⚡ IMU (RAW)</div>
                <div class="sensor-item">
                    <span class="sensor-label">Accel X/Y/Z:</span>
                    <span class="sensor-value">@sensorData.AccelX.ToString("0.00") / @sensorData.AccelY.ToString("0.00") / @sensorData.AccelZ.ToString("0.00")</span>
                </div>
                <div class="sensor-item">
                    <span class="sensor-label">Gyro X/Y/Z:</span>
                    <span class="sensor-value">@sensorData.GyroX.ToString("0.00") / @sensorData.GyroY.ToString("0.00") / @sensorData.GyroZ.ToString("0.00")</span>
                </div>
                <div class="sensor-item">
                    <span class="sensor-label">Mag X/Y/Z:</span>
                    <span class="sensor-value">@sensorData.MagX / @sensorData.MagY / @sensorData.MagZ</span>
                </div>
            </div>

            <div class="sensor-section">
                <div class="section-title">🧭 Compass</div>
                <div class="compass-instrument" aria-label="Compass indicator">
                    <div class="compass-pointer"></div>
                    <div class="compass-rose" style="@GetCompassRoseStyle()">
                        <span class="cardinal north">N</span>
                        <span class="cardinal east">E</span>
                        <span class="cardinal south">S</span>
                        <span class="cardinal west">W</span>
                        <span class="compass-ring"></span>
                        <span class="compass-cross horizontal"></span>
                        <span class="compass-cross vertical"></span>
                    </div>
                    <div class="compass-heading">@NormalizeHeading(sensorData.CompassHeading).ToString("000")°</div>
                </div>
                <div class="sensor-item">
                    <span class="sensor-label">Heading:</span>
                    <span class="sensor-value">@sensorData.CompassHeading.ToString("0")°</span>
                </div>
            </div>

            <div class="sensor-update-time">
                Last update: @sensorData.LastUpdate.ToString("HH:mm:ss")
            </div>
        </aside>
    </div>
</div>

@code {
    private readonly CancellationTokenSource statusCancellation = new();
    private CancellationTokenSource? sensorPollingCancellation;

    private string status = "Ready";
    private string error = "";
    private string response = "";
    private bool isBusy;
    private bool isConnected;

    private string connectionString = "udpin:0.0.0.0:14551";
    private int baudRate = 57600;
    private double heartbeat = 10.0;

    private string selectedMode = "STABILIZE";
    private double takeoffAltitudeMeters = 5.0;
    private bool armBeforeTakeoff = true;

    private double controlStrength = 0.45;
    private double controlDuration = 0.35;
    private double yawSpeed = 35.0;
    private int throttlePwm = 1500;
    private double throttleDuration = 0.25;
    private double joystickForward;
    private double joystickRight;
    private double joystickThrottle;
    private double joystickYaw;
    private bool isJoystickStreaming;
    private CancellationTokenSource? joystickCancellation;
    private string rawCommandText = "22 0 0 0 0 0 0 5";

    private DroneApiService.SensorData sensorData = new();

    protected override void OnInitialized()
    {
        _ = PollStatusAsync(statusCancellation.Token);
        _ = PollSensorDataAsync();
    }

    private async Task PollSensorDataAsync()
    {
        sensorPollingCancellation = new CancellationTokenSource();

        try
        {
            while (!sensorPollingCancellation.Token.IsCancellationRequested)
            {
                await Task.Delay(500, sensorPollingCancellation.Token);
                await RefreshSensorData();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshSensorData()
    {
        if (!isConnected) return;

        try
        {
            var telemetry = await Drone.GetTelemetry();
            if (telemetry.Success && telemetry.Data != null)
            {
                sensorData = telemetry.Data;
                sensorData.LastUpdate = DateTime.Now;
            }
        }
        catch (Exception) { }
    }

    private static string GetGpsFixText(int fix)
    {
        return fix switch
        {
            0 => "No GPS",
            1 => "No Fix",
            2 => "2D Fix",
            3 => "3D Fix",
            4 => "DGPS",
            5 => "RTK Float",
            6 => "RTK Fixed",
            _ => $"Fix {fix}"
        };
    }

    private string GetAttitudeHorizonStyle()
    {
        var rollDegrees = Math.Clamp(sensorData.GyroX * 45.0, -50.0, 50.0);
        var pitchPixels = Math.Clamp(sensorData.GyroY * -34.0, -44.0, 44.0);

        return $"transform: translate(-50%, -50%) rotate({CssNumber(rollDegrees)}deg) translateY({CssNumber(pitchPixels)}px);";
    }

    private string GetCompassRoseStyle()
    {
        return $"transform: rotate({CssNumber(-NormalizeHeading(sensorData.CompassHeading))}deg);";
    }

    private static double NormalizeHeading(double heading)
    {
        var normalized = heading % 360.0;
        return normalized < 0 ? normalized + 360.0 : normalized;
    }

    private static string CssNumber(double value)
    {
        return value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    }

    private async Task Handle(string name, Func<Task<DroneApiService.ApiResponse<object>>> action)
    {
        error = "";
        response = "";
        status = $"{name}...";
        isBusy = true;

        try
        {
            var result = await action();

            if (result.Success)
            {
                status = $"{name} OK";
                response = result.ResponseBody ?? "";
                await RefreshStatus(false);
            }
            else
            {
                status = $"{name} failed";
                error = result.ErrorMessage ?? result.ResponseBody ?? "Unknown error";
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private Task ConnectAsync()
    {
        var trimmed = connectionString.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            status = "Connect blocked";
            error = "Enter a MAVLink endpoint";
            return Task.CompletedTask;
        }

        return Handle("Connect", async () =>
        {
            var result = await Drone.Connect(trimmed, baudRate, heartbeat);
            isConnected = result.Success;
            return result;
        });
    }

    private Task DisconnectAsync()
    {
        return Handle("Disconnect", async () =>
        {
            var result = await Drone.Disconnect();
            isConnected = false;
            sensorData = new DroneApiService.SensorData();
            return result;
        });
    }

    private Task SetModeAsync() => Handle("Set mode", () => Drone.SetMode(selectedMode));
    private Task ArmAsync() => Handle("Arm", Drone.Arm);
    private Task DisarmAsync() => Handle("Disarm", Drone.Disarm);
    private Task TakeoffAsync() => Handle("Takeoff", () => Drone.Takeoff(takeoffAltitudeMeters, armBeforeTakeoff));
    private Task LandAsync() => Handle("Land", Drone.Land);
    private Task StopAsync() => SendVelocityCommand("Stop", 0, 0, 0);

    private Task MoveForwardAsync() => SendVelocityCommand("Forward", controlStrength, 0, 0);
    private Task MoveBackAsync() => SendVelocityCommand("Back", -controlStrength, 0, 0);
    private Task MoveLeftAsync() => SendVelocityCommand("Left", 0, -controlStrength, 0);
    private Task MoveRightAsync() => SendVelocityCommand("Right", 0, controlStrength, 0);
    private Task MoveUpAsync() => SendVelocityCommand("Up", 0, 0, -controlStrength);
    private Task MoveDownAsync() => SendVelocityCommand("Down", 0, 0, controlStrength);
    private Task YawLeftAsync() => Handle("Yaw left", () => Drone.Yaw(-20, yawSpeed, true));
    private Task YawRightAsync() => Handle("Yaw right", () => Drone.Yaw(20, yawSpeed, true));
    private Task SendThrottleAsync() => Handle("Throttle", () => Drone.SendThrottle(throttlePwm, throttleDuration));
    private Task SendVirtualJoystickAsync() => Handle("Virtual joystick", () => Drone.SendVirtualJoystick(
        Math.Clamp(joystickForward * controlStrength, -1.0, 1.0),
        Math.Clamp(joystickRight * controlStrength, -1.0, 1.0),
        Math.Clamp(joystickThrottle, -1.0, 1.0),
        Math.Clamp(joystickYaw * controlStrength, -1.0, 1.0),
        Math.Clamp(controlDuration, 0.0, 5.0)));

    private Task StartVirtualJoystickStreamAsync()
    {
        if (isJoystickStreaming) return Task.CompletedTask;

        joystickCancellation = new CancellationTokenSource();
        isJoystickStreaming = true;
        status = "Virtual joystick streaming";
        _ = StreamVirtualJoystickAsync(joystickCancellation.Token);
        return Task.CompletedTask;
    }

    private async Task StopVirtualJoystickStreamAsync()
    {
        joystickCancellation?.Cancel();
        joystickCancellation?.Dispose();
        joystickCancellation = null;
        isJoystickStreaming = false;
        joystickForward = 0;
        joystickRight = 0;
        joystickThrottle = 0;
        joystickYaw = 0;
        await Handle("Virtual joystick center", () => Drone.SendVirtualJoystick(0, 0, 0, 0, 0.1));
    }

    private async Task StreamVirtualJoystickAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(100, cancellationToken);
                var result = await Drone.SendVirtualJoystick(
                    Math.Clamp(joystickForward * controlStrength, -1.0, 1.0),
                    Math.Clamp(joystickRight * controlStrength, -1.0, 1.0),
                    Math.Clamp(joystickThrottle, -1.0, 1.0),
                    Math.Clamp(joystickYaw * controlStrength, -1.0, 1.0),
                    0);

                if (!result.Success)
                {
                    status = "Virtual joystick failed";
                    error = result.ErrorMessage ?? result.ResponseBody ?? "";
                    isJoystickStreaming = false;
                    break;
                }
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            isJoystickStreaming = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task SendRawCommandAsync()
    {
        var parts = rawCommandText.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 8)
        {
            status = "Raw command blocked";
            error = "Need 8 numbers: command_id param1 param2 param3 param4 param5 param6 param7";
            return Task.CompletedTask;
        }

        if (!int.TryParse(parts[0], out var cmdId))
        {
            status = "Raw command blocked";
            error = "First value must be command ID (integer)";
            return Task.CompletedTask;
        }

        var p = new double[7];
        for (int i = 0; i < 7; i++)
        {
            if (!double.TryParse(parts[i + 1], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out p[i]))
            {
                status = "Raw command blocked";
                error = $"Parameter {i + 1} is not a number";
                return Task.CompletedTask;
            }
        }

        return Handle("Raw command", () => Drone.RawCommand(cmdId, p[0], p[1], p[2], p[3], p[4], p[5], p[6]));
    }

    private Task SendVelocityCommand(string name, double vx, double vy, double vz)
    {
        return Handle(name, () => Drone.SendVelocity(
            Math.Clamp(vx, -1.0, 1.0),
            Math.Clamp(vy, -1.0, 1.0),
            Math.Clamp(vz, -1.0, 1.0),
            Math.Clamp(controlDuration, 0.0, 5.0)));
    }

    private void SetRawCommandExample(string command) => rawCommandText = command;

    private async Task RefreshStatus() => await RefreshStatus(true);

    private async Task RefreshStatus(bool showErrors)
    {
        try
        {
            var statusStr = await Drone.GetStatus();
            isConnected = statusStr.Contains("\"connected\":true", StringComparison.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            if (showErrors)
            {
                status = "Status failed";
                error = ex.Message;
            }
        }
    }

    private async Task PollStatusAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(1000, cancellationToken);
                if (isConnected)
                {
                    await RefreshStatus(false);
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        joystickCancellation?.Cancel();
        statusCancellation.Cancel();
        sensorPollingCancellation?.Cancel();
        await ValueTask.CompletedTask;
    }
}

<style>
    :root {
        color-scheme: dark;
    }

    body {
        background: #101418;
        color: #e8edf2;
    }

    .drone-shell {
        display: flex;
        flex-direction: column;
        gap: 20px;
        max-width: 1600px;
        margin: 0 auto;
        padding: 22px 20px 36px;
    }

    .main-layout {
        display: flex;
        gap: 20px;
    }

    .content-area {
        flex: 1;
        min-width: 0;
    }

    .sensor-sidebar {
        width: 340px;
        flex-shrink: 0;
        background: #171d23;
        border: 1px solid #2b3540;
        border-radius: 12px;
        padding: 16px;
        max-height: calc(100vh - 120px);
        overflow-y: auto;
    }

    .sidebar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
