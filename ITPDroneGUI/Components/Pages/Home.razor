@page "/"
@implements IAsyncDisposable
@inject DroneApiService Drone

<PageTitle>Drone Control</PageTitle>

<div class="drone-shell">
    <header class="drone-header">
        <div>
            <p class="eyebrow">ArduCopter SITL</p>
            <h1>Drone Control</h1>
        </div>
        <div class="connection-state @(isConnected ? "online" : "offline")">
            <span></span>
            @(isConnected ? "Connected" : "Disconnected")
        </div>
    </header>

    <section class="control-grid">
        <div class="panel">
            <div class="panel-heading">
                <h2>Connection</h2>
                <button class="ghost-button" type="button" @onclick="RefreshStatus">Status</button>
            </div>

            <label for="connectionString">MAVLink endpoint</label>
            <input id="connectionString" @bind="connectionString" @bind:event="oninput" placeholder="udpin:0.0.0.0:14551" />

            <div class="inline-fields">
                <label>
                    Baud
                    <input type="number" @bind="baudRate" min="1" />
                </label>
                <label>
                    Timeout
                    <input type="number" @bind="heartbeat" min="0.1" max="60" step="0.1" />
                </label>
            </div>

            <div class="button-row">
                <button class="primary-button" type="button" @onclick="ConnectAsync" disabled="@isBusy">Connect</button>
                <button type="button" @onclick="DisconnectAsync" disabled="@isBusy">Disconnect</button>
            </div>
        </div>

        <div class="panel">
            <div class="panel-heading">
                <h2>Flight</h2>
            </div>

            <div class="inline-fields">
                <label>
                    Mode
                    <select @bind="selectedMode">
                        <option>STABILIZE</option>
                        <option>ALT_HOLD</option>
                        <option>GUIDED</option>
                        <option>LOITER</option>
                        <option>LAND</option>
                    </select>
                </label>
                <label>
                    Takeoff height
                    <input type="number" @bind="takeoffAltitudeMeters" min="1" max="50" step="0.5" />
                </label>
            </div>

            <label class="checkbox-label">
                <input type="checkbox" @bind="armBeforeTakeoff" />
                Arm first
            </label>

            <div class="button-row">
                <button type="button" @onclick="SetModeAsync" disabled="@isBusy">Set Mode</button>
                <button type="button" @onclick="ArmAsync" disabled="@isBusy">Arm</button>
                <button type="button" @onclick="DisarmAsync" disabled="@isBusy">Disarm</button>
                <button class="primary-button" type="button" @onclick="TakeoffAsync" disabled="@isBusy">Takeoff</button>
                <button class="danger-button" type="button" @onclick="LandAsync" disabled="@isBusy">Land</button>
            </div>
        </div>

        <div class="panel wide-panel">
            <div class="panel-heading">
                <h2>Live Control</h2>
                <button class="stop-button" type="button" @onclick="StopAsync" disabled="@isBusy">Stop</button>
            </div>

            <div class="inline-fields">
                <label>
                    Strength
                    <input type="number" @bind="controlStrength" min="0.05" max="1" step="0.05" />
                </label>
                <label>
                    Pulse
                    <input type="number" @bind="controlDuration" min="0" max="5" step="0.05" />
                </label>
                <label>
                    Yaw speed
                    <input type="number" @bind="yawSpeed" min="1" max="100" step="1" />
                </label>
            </div>

            <div class="joystick-panel">
                <div class="joystick-sliders">
                    <label>
                        Forward / Back
                        <input type="range" @bind="joystickForward" @bind:event="oninput" min="-1" max="1" step="0.05" />
                        <output>@joystickForward.ToString("0.00")</output>
                    </label>
                    <label>
                        Left / Right
                        <input type="range" @bind="joystickRight" @bind:event="oninput" min="-1" max="1" step="0.05" />
                        <output>@joystickRight.ToString("0.00")</output>
                    </label>
                    <label>
                        Throttle
                        <input type="range" @bind="joystickThrottle" @bind:event="oninput" min="-1" max="1" step="0.05" />
                        <output>@joystickThrottle.ToString("0.00")</output>
                    </label>
                    <label>
                        Yaw
                        <input type="range" @bind="joystickYaw" @bind:event="oninput" min="-1" max="1" step="0.05" />
                        <output>@joystickYaw.ToString("0.00")</output>
                    </label>
                </div>

                <div class="button-row">
                    <button class="primary-button" type="button" @onclick="StartVirtualJoystickStreamAsync" disabled="@(isBusy || isJoystickStreaming)">Start Stick Stream</button>
                    <button type="button" @onclick="SendVirtualJoystickAsync" disabled="@isBusy">Send Once</button>
                    <button class="stop-button" type="button" @onclick="StopVirtualJoystickStreamAsync" disabled="@isBusy">Center / Stop</button>
                </div>
            </div>

            <div class="button-pad">
                <button type="button" @onclick="MoveForwardAsync" disabled="@isBusy">Forward</button>
                <button type="button" @onclick="MoveLeftAsync" disabled="@isBusy">Left</button>
                <button class="stop-button" type="button" @onclick="StopAsync" disabled="@isBusy">Stop</button>
                <button type="button" @onclick="MoveRightAsync" disabled="@isBusy">Right</button>
                <button type="button" @onclick="MoveBackAsync" disabled="@isBusy">Back</button>
            </div>

            <div class="button-row">
                <button type="button" @onclick="MoveUpAsync" disabled="@isBusy">Up</button>
                <button type="button" @onclick="MoveDownAsync" disabled="@isBusy">Down</button>
                <button type="button" @onclick="YawLeftAsync" disabled="@isBusy">Yaw Left</button>
                <button type="button" @onclick="YawRightAsync" disabled="@isBusy">Yaw Right</button>
            </div>

            <div class="inline-fields">
                <label>
                    Throttle PWM
                    <input type="number" @bind="throttlePwm" min="1000" max="2000" step="10" />
                </label>
                <label>
                    Duration
                    <input type="number" @bind="throttleDuration" min="0" max="30" step="0.1" />
                </label>
            </div>

            <button type="button" @onclick="SendThrottleAsync" disabled="@isBusy">Send Throttle</button>
        </div>

        <div class="panel wide-panel">
            <div class="panel-heading">
                <h2>MAVLink Console</h2>
            </div>

            <label for="rawCommandText">Raw command</label>
            <textarea id="rawCommandText" @bind="rawCommandText" @bind:event="oninput" rows="4" spellcheck="false"></textarea>

            <div class="button-row">
                <button type="button" @onclick='() => SetRawCommandExample("command_long 22 0 0 0 0 0 0 5")'>Takeoff 5m</button>
                <button type="button" @onclick='() => SetRawCommandExample("command_long 400 1 0 0 0 0 0 0")'>Arm</button>
                <button type="button" @onclick='() => SetRawCommandExample("command_long 400 0 0 0 0 0 0 0")'>Disarm</button>
            </div>

            <button class="primary-button" type="button" @onclick="SendRawCommandAsync" disabled="@isBusy">Send Command</button>
        </div>
    </section>

    <section class="telemetry-band">
        <div>
            <p class="eyebrow">Last action</p>
            <strong>@status</strong>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <pre class="error-output">@error</pre>
        }

        @if (!string.IsNullOrWhiteSpace(response))
        {
            <pre>@response</pre>
        }

        @if (!string.IsNullOrWhiteSpace(statusJson))
        {
            <pre>@statusJson</pre>
        }
    </section>
</div>

@code {
    private readonly CancellationTokenSource statusCancellation = new();

    private string status = "Ready";
    private string error = "";
    private string response = "";
    private string statusJson = "";
    private string rawCommandText = "command_long 22 0 0 0 0 0 0 5";
    private bool isBusy;
    private bool isConnected;

    private string connectionString = "udpin:0.0.0.0:14551";
    private int baudRate = 57600;
    private double heartbeat = 10.0;

    private string selectedMode = "STABILIZE";
    private double takeoffAltitudeMeters = 5.0;
    private bool armBeforeTakeoff = true;

    private double controlStrength = 0.45;
    private double controlDuration = 0.35;
    private double yawSpeed = 35.0;
    private int throttlePwm = 1500;
    private double throttleDuration = 0.25;
    private double joystickForward;
    private double joystickRight;
    private double joystickThrottle;
    private double joystickYaw;
    private bool isJoystickStreaming;
    private CancellationTokenSource? joystickCancellation;

    protected override void OnInitialized()
    {
        _ = PollStatusAsync(statusCancellation.Token);
    }

    private async Task Handle(string name, Func<Task<DroneApiService.ApiResponse<object>>> action)
    {
        error = "";
        response = "";
        status = $"{name}...";
        isBusy = true;

        try
        {
            var result = await action();

            if (result.Success)
            {
                status = $"{name} OK";
                response = result.ResponseBody ?? "";
                await RefreshStatus(showErrors: false);
            }
            else
            {
                status = $"{name} failed";
                error = CombineError(result.ErrorMessage, result.ResponseBody);
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private Task ConnectAsync()
    {
        var trimmedConnectionString = connectionString.Trim();

        if (string.IsNullOrWhiteSpace(trimmedConnectionString))
        {
            status = "Connect blocked";
            error = "Enter a MAVLink endpoint such as udpin:0.0.0.0:14551 or tcp:127.0.0.1:5763.";
            response = "";
            isConnected = false;
            return Task.CompletedTask;
        }

        return Handle("Connect", async () =>
        {
            var result = await Drone.Connect(trimmedConnectionString, baudRate, heartbeat);
            isConnected = result.Success;
            return result;
        });
    }

    private Task DisconnectAsync()
    {
        return Handle("Disconnect", async () =>
        {
            var result = await Drone.Disconnect();
            isConnected = false;
            statusJson = "";
            return result;
        });
    }

    private Task SetModeAsync() => Handle("Set mode", () => Drone.SetMode(selectedMode));
    private Task ArmAsync() => Handle("Arm", Drone.Arm);
    private Task DisarmAsync() => Handle("Disarm", Drone.Disarm);
    private Task TakeoffAsync() => Handle("Takeoff 5m", () => Drone.Takeoff(takeoffAltitudeMeters, armBeforeTakeoff));
    private Task LandAsync() => Handle("Land", Drone.Land);
    private Task StopAsync() => SendVelocityCommand("Stop", 0, 0, 0);

    private Task MoveForwardAsync() => SendVelocityCommand("Forward", controlStrength, 0, 0);
    private Task MoveBackAsync() => SendVelocityCommand("Back", -controlStrength, 0, 0);
    private Task MoveLeftAsync() => SendVelocityCommand("Left", 0, -controlStrength, 0);
    private Task MoveRightAsync() => SendVelocityCommand("Right", 0, controlStrength, 0);
    private Task MoveUpAsync() => SendVelocityCommand("Up", 0, 0, -controlStrength);
    private Task MoveDownAsync() => SendVelocityCommand("Down", 0, 0, controlStrength);
    private Task YawLeftAsync() => Handle("Yaw left", () => Drone.Yaw(-20, yawSpeed, true));
    private Task YawRightAsync() => Handle("Yaw right", () => Drone.Yaw(20, yawSpeed, true));
    private Task SendThrottleAsync() => Handle("Throttle", () => Drone.SendThrottle(throttlePwm, throttleDuration));
    private Task SendVirtualJoystickAsync() => Handle("Virtual joystick", () => Drone.SendVirtualJoystick(
        Math.Clamp(joystickForward * controlStrength, -1.0, 1.0),
        Math.Clamp(joystickRight * controlStrength, -1.0, 1.0),
        Math.Clamp(joystickThrottle, -1.0, 1.0),
        Math.Clamp(joystickYaw * controlStrength, -1.0, 1.0),
        Math.Clamp(controlDuration, 0.0, 5.0)));

    private Task StartVirtualJoystickStreamAsync()
    {
        if (isJoystickStreaming)
        {
            return Task.CompletedTask;
        }

        joystickCancellation = new CancellationTokenSource();
        isJoystickStreaming = true;
        status = "Virtual joystick streaming";
        _ = StreamVirtualJoystickAsync(joystickCancellation.Token);
        return Task.CompletedTask;
    }

    private async Task StopVirtualJoystickStreamAsync()
    {
        joystickCancellation?.Cancel();
        joystickCancellation?.Dispose();
        joystickCancellation = null;
        isJoystickStreaming = false;
        joystickForward = 0;
        joystickRight = 0;
        joystickThrottle = 0;
        joystickYaw = 0;
        await Handle("Virtual joystick center", () => Drone.SendVirtualJoystick(0, 0, 0, 0, 0.1));
    }

    private async Task StreamVirtualJoystickAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));

            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var result = await Drone.SendVirtualJoystick(
                    Math.Clamp(joystickForward * controlStrength, -1.0, 1.0),
                    Math.Clamp(joystickRight * controlStrength, -1.0, 1.0),
                    Math.Clamp(joystickThrottle, -1.0, 1.0),
                    Math.Clamp(joystickYaw * controlStrength, -1.0, 1.0),
                    0);

                if (!result.Success)
                {
                    status = "Virtual joystick failed";
                    error = CombineError(result.ErrorMessage, result.ResponseBody);
                    isJoystickStreaming = false;
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            isJoystickStreaming = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task SendRawCommandAsync()
    {
        if (!TryParseRawCommand(rawCommandText, out var commandId, out var parameters, out var parseError))
        {
            status = "Raw command blocked";
            error = parseError;
            response = "";
            return Task.CompletedTask;
        }

        return Handle("Raw command", () => Drone.RawCommand(
            commandId,
            parameters[0],
            parameters[1],
            parameters[2],
            parameters[3],
            parameters[4],
            parameters[5],
            parameters[6]));
    }

    private Task SendVelocityCommand(string name, double vx, double vy, double vz)
    {
        return Handle(name, () => Drone.SendVelocity(
            Math.Clamp(vx, -1.0, 1.0),
            Math.Clamp(vy, -1.0, 1.0),
            Math.Clamp(vz, -1.0, 1.0),
            Math.Clamp(controlDuration, 0.0, 5.0)));
    }

    private void SetRawCommandExample(string command)
    {
        rawCommandText = command;
    }

    private static bool TryParseRawCommand(
        string input,
        out int commandId,
        out double[] parameters,
        out string errorMessage)
    {
        commandId = 0;
        parameters = new double[7];
        errorMessage = "";

        var tokens = input
            .Split(new[] { ' ', '\r', '\n', '\t', ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
            .ToList();

        if (tokens.Count > 0 && IsCommandLongAlias(tokens[0]))
        {
            tokens.RemoveAt(0);
        }

        if (tokens.Count == 0)
        {
            errorMessage = "Gib z.B. ein: command_long 22 0 0 0 0 0 0 5";
            return false;
        }

        if (!int.TryParse(tokens[0], out commandId) || commandId <= 0)
        {
            errorMessage = "Der erste Wert muss eine MAVLink command_id groesser als 0 sein.";
            return false;
        }

        for (var index = 1; index < tokens.Count && index <= 7; index++)
        {
            if (!TryParseDouble(tokens[index], out parameters[index - 1]))
            {
                errorMessage = $"Parameter {index} ist keine Zahl: {tokens[index]}";
                return false;
            }
        }

        return true;
    }

    private static bool IsCommandLongAlias(string token)
    {
        return string.Equals(token, "command_long", StringComparison.OrdinalIgnoreCase)
            || string.Equals(token, "cmd_long", StringComparison.OrdinalIgnoreCase)
            || string.Equals(token, "command", StringComparison.OrdinalIgnoreCase)
            || string.Equals(token, "cmd", StringComparison.OrdinalIgnoreCase);
    }

    private static bool TryParseDouble(string value, out double parsed)
    {
        return double.TryParse(
                value,
                System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture,
                out parsed)
            || double.TryParse(value, out parsed);
    }

    private async Task RefreshStatus()
    {
        await RefreshStatus(showErrors: true);
    }

    private async Task RefreshStatus(bool showErrors)
    {
        try
        {
            statusJson = await Drone.GetStatus();
            isConnected = statusJson.Contains("\"connected\":true", StringComparison.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            if (showErrors)
            {
                status = "Status failed";
                error = ex.Message;
            }
        }
    }

    private async Task PollStatusAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (!isConnected)
                {
                    continue;
                }

                await RefreshStatus(showErrors: false);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private static string CombineError(string? message, string? body)
    {
        if (string.IsNullOrWhiteSpace(body))
        {
            return message ?? "Unknown error";
        }

        if (string.IsNullOrWhiteSpace(message))
        {
            return body;
        }

        return $"{message}{Environment.NewLine}{body}";
    }

    public ValueTask DisposeAsync()
    {
        joystickCancellation?.Cancel();
        joystickCancellation?.Dispose();
        statusCancellation.Cancel();
        statusCancellation.Dispose();
        return ValueTask.CompletedTask;
    }
}

<style>
    :root {
        color-scheme: dark;
    }

    body {
        background: #101418;
        color: #e8edf2;
    }

    .drone-shell {
        display: flex;
        flex-direction: column;
        gap: 20px;
        max-width: 1180px;
        margin: 0 auto;
        padding: 22px 0 36px;
    }

    .drone-header,
    .telemetry-band,
    .panel {
        border: 1px solid #2b3540;
        background: #171d23;
        border-radius: 8px;
    }

    .drone-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 20px;
    }

    .eyebrow {
        margin: 0 0 4px;
        color: #9fb1c1;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0;
    }

    h1,
    h2 {
        margin: 0;
        letter-spacing: 0;
    }

    h1 {
        font-size: 2rem;
    }

    h2 {
        font-size: 1rem;
    }

    .connection-state {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-width: 132px;
        justify-content: center;
        padding: 8px 10px;
        border: 1px solid #34404c;
        border-radius: 6px;
        color: #b7c5d1;
        font-weight: 700;
    }

    .connection-state span {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: #db5c5c;
    }

    .connection-state.online span {
        background: #4cc27a;
    }

    .control-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .panel {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 16px;
    }

    .wide-panel {
        grid-column: span 2;
    }

    .panel-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    label {
        display: flex;
        flex-direction: column;
        gap: 6px;
        color: #b7c5d1;
        font-size: 0.85rem;
        font-weight: 700;
    }

    input,
    select,
    textarea {
        width: 100%;
        min-height: 40px;
        padding: 8px 10px;
        border: 1px solid #34404c;
        border-radius: 6px;
        background: #0f1419;
        color: #f4f7fa;
        font: inherit;
    }

    textarea {
        min-height: 112px;
        resize: vertical;
    }

    .inline-fields,
    .button-row {
        display: grid;
        gap: 10px;
    }

    .inline-fields {
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    }

    .button-row {
        grid-template-columns: repeat(auto-fit, minmax(118px, 1fr));
    }

    .button-pad {
        display: grid;
        grid-template-columns: repeat(3, minmax(96px, 1fr));
        gap: 10px;
        max-width: 520px;
    }

    .joystick-panel {
        display: grid;
        gap: 12px;
        padding: 12px;
        border: 1px solid #2b3540;
        border-radius: 6px;
        background: #111820;
    }

    .joystick-sliders {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
    }

    .joystick-sliders label {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 8px;
    }

    .joystick-sliders input {
        grid-column: 1 / -1;
        min-height: 28px;
        padding: 0;
    }

    .joystick-sliders output {
        min-width: 48px;
        color: #f4f7fa;
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .button-pad button:first-child,
    .button-pad button:last-child {
        grid-column: 2;
    }

    .button-pad button:last-child {
        grid-row: 3;
    }

    button {
        min-height: 42px;
        border: 1px solid #40505f;
        border-radius: 6px;
        background: #25313b;
        color: #f4f7fa;
        font-weight: 800;
        cursor: pointer;
    }

    button:hover:not(:disabled) {
        background: #31404d;
    }

    button:disabled {
        cursor: progress;
        opacity: 0.6;
    }

    .primary-button {
        background: #176b8f;
        border-color: #2482ab;
    }

    .danger-button {
        background: #8c2d33;
        border-color: #b74850;
    }

    .stop-button {
        background: #75511b;
        border-color: #a9792d;
    }

    .ghost-button {
        min-height: 36px;
        background: transparent;
    }

    .checkbox-label {
        flex-direction: row;
        align-items: center;
        min-height: 40px;
    }

    .checkbox-label input {
        width: 18px;
        min-height: 18px;
    }

    .telemetry-band {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 16px;
    }

    pre {
        width: 100%;
        max-height: 240px;
        margin: 0;
        overflow: auto;
        border: 1px solid #2b3540;
        border-radius: 6px;
        background: #0f1419;
        color: #d9e4ee;
        padding: 12px;
        white-space: pre-wrap;
    }

    .error-output {
        border-color: #914047;
        color: #ffb8bf;
    }

    @@media (max-width: 760px) {
        .drone-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .control-grid,
        .wide-panel {
            grid-template-columns: 1fr;
            grid-column: auto;
        }

        .button-pad {
            max-width: none;
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
</style>
