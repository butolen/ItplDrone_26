    private static bool IsEndBlock(BlockKind kind)
    {
        return kind is BlockKind.Land or BlockKind.Disarm or BlockKind.ReturnHome or BlockKind.FailsafeReturn or BlockKind.FailsafeLand;
    }

    private static MarkupString BlockShapeSvg(BlockKind kind)
    {
        return IsEndBlock(kind) ? EndBlockSvg : NormalBlockSvg;
    }

    private static string CombineError(string? message, string? body)
    {
        if (string.IsNullOrWhiteSpace(body))
        {
            return message ?? "Unknown error";
        }

        if (string.IsNullOrWhiteSpace(message))
        {
            return body;
        }

        return $"{message}{Environment.NewLine}{body}";
    }

    private static double NormalizeHeading(double heading)
    {
        var result = heading % 360.0;
        return result < 0 ? result + 360.0 : result;
    }

    private static double HeadingDelta(double current, double target)
    {
        var delta = Math.Abs(NormalizeHeading(current) - NormalizeHeading(target));
        return Math.Min(delta, 360.0 - delta);
    }

    private static double DistanceMeters(double lat1, double lon1, double lat2, double lon2)
    {
        const double earthRadiusMeters = 6371000.0;
        var dLat = DegreesToRadians(lat2 - lat1);
        var dLon = DegreesToRadians(lon2 - lon1);
        var a = Math.Pow(Math.Sin(dLat / 2), 2)
            + Math.Cos(DegreesToRadians(lat1))
            * Math.Cos(DegreesToRadians(lat2))
            * Math.Pow(Math.Sin(dLon / 2), 2);
        return 2 * earthRadiusMeters * Math.Asin(Math.Min(1.0, Math.Sqrt(a)));
    }

    private static double DegreesToRadians(double degrees) => degrees * Math.PI / 180.0;

    public async ValueTask DisposeAsync()
    {
        telemetryCancellation.Cancel();
        telemetryCancellation.Dispose();
        missionCancellation?.Cancel();
        missionCancellation?.Dispose();

        if (hasInitializedGpsMapResize)
        {
            try
            {
                if (procedureMapModule is not null)
                {
                    await procedureMapModule.InvokeVoidAsync("disposeResize", gpsMapCardReference);
                }
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }

        if (procedureMapModule is not null)
        {
            try
            {
                await procedureMapModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        procedureReference?.Dispose();
    }

    private sealed record BlockTemplate(BlockKind Kind, string Label);
    private sealed record MapTrailPoint(double EastMeters, double NorthMeters, double? HeadingDegrees);

    private sealed class MissionBlock(BlockKind kind)
    {
        public Guid Id { get; } = Guid.NewGuid();
        public BlockKind Kind { get; } = kind;
        public double Altitude { get; set; }
        public double Speed { get; set; }
        public double Seconds { get; set; }
        public double Degrees { get; set; }
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public double LocalX { get; set; }
        public double LocalY { get; set; }
        public double Radius { get; set; }
        public double Tolerance { get; set; }
        public double TimeoutSeconds { get; set; }
        public int Count { get; set; }
        public int Percent { get; set; }
        public FlightDirection Direction { get; set; }

        public double ToleranceOrDefault(double fallback) => Tolerance > 0 ? Tolerance : fallback;
        public double TimeoutSecondsOrDefault(double fallback) => TimeoutSeconds > 0 ? TimeoutSeconds : fallback;
    }

    private enum BlockKind
    {
        Arm,
        Takeoff,
        Fly,
        Turn,
        ChangeAltitude,
        Hover,
        GotoGps,
        GotoLocal,
        ReturnHome,
        Land,
        Disarm,
        Wait,
        WaitUntilAltitude,
        WaitUntilGpsFix,
        RepeatNext,
        IfBatteryBelow,
