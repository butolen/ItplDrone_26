        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        min-height: 24px;
        margin-bottom: 8px;
    }

    .block-title button {
        width: 24px;
        height: 24px;
        border: 0;
        border-radius: 3px;
