    private sealed class MissionBlock(BlockKind kind)
    {
        public Guid Id { get; } = Guid.NewGuid();
        public BlockKind Kind { get; } = kind;
        public double Altitude { get; set; }
        public double Speed { get; set; }
        public double Seconds { get; set; }
        public double Degrees { get; set; }
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public double LocalX { get; set; }
        public double LocalY { get; set; }
        public double Radius { get; set; }
        public double Tolerance { get; set; }
        public double TimeoutSeconds { get; set; }
        public int Count { get; set; }
        public int Percent { get; set; }
        public FlightDirection Direction { get; set; }

        public double ToleranceOrDefault(double fallback) => Tolerance > 0 ? Tolerance : fallback;
        public double TimeoutSecondsOrDefault(double fallback) => TimeoutSeconds > 0 ? TimeoutSeconds : fallback;
    }

