@page "/procedure"
@implements IAsyncDisposable
@inject DroneApiService Drone
@inject ProcedureStorageService Storage

<PageTitle>DroneForge</PageTitle>

<div class="forge-page">
    <header class="forge-toolbar">
        <div class="brand">
            <span class="brand-logo" aria-hidden="true">@DroneLogoSvg</span>
            <span>DroneForge</span>
        </div>

        <div class="telemetry">
            <span>ALT: @AltitudeLabel</span>
            <span>MODE: @ModeLabel</span>
            <span>@ArmLabel</span>
        </div>

        <div class="mission-actions">
            <select class="route-select" title="Saved routes" value="@selectedRouteId" @onchange="LoadRouteSelectionAsync" disabled="@(isRunning || isLoadingRoutes)">
                <option value="">Saved routes</option>
                @foreach (var route in savedRoutes)
                {
                    <option value="@route.Id">@route.Name</option>
                }
            </select>
            <input class="route-name-input" type="text" placeholder="Route name" @bind="routeName" @bind:event="oninput" disabled="@isRunning" />
            <button class="save-route-button" type="button" @onclick="SaveRouteAsync" disabled="@(isRunning || isSavingRoute || missionBlocks.Count == 0)">
                @(isSavingRoute ? "SAVING" : "SAVE ROUTE")
            </button>
            <button class="optimize-route-button" type="button" @onclick="OptimizeGpsRouteAsync" disabled="@(!CanOptimizeGpsRoute)">
                OPTIMIZE GPS
            </button>
            <button class="connect-button" type="button" @onclick="ToggleConnectionAsync" disabled="@(isConnecting || isRunning)">
                @ConnectButtonLabel
            </button>
            <select class="mode-select" title="Flight mode" value="@selectedMode" @onchange="ChangeModeAsync" disabled="@(!isConnected || isRunning || isChangingMode)">
                @foreach (var mode in selectableModes)
                {
                    <option value="@mode">@mode</option>
                }
            </select>
            <button class="run-button" type="button" @onclick="RunMissionAsync" disabled="@(!CanRunMission)">
                <span class="play-symbol" aria-hidden="true">@PlaySymbolSvg</span>
                <span>RUN MISSION</span>
            </button>
            <button class="abort-button" type="button" @onclick="AbortMissionAsync" disabled="@(!isRunning && !isConnected)">ABORT MISSION</button>
        </div>
    </header>

    <main class="forge-workbench">
        <aside class="block-palette">
            @RenderPaletteSection("Movement", movementTemplates)
            @RenderPaletteSection("Navigation", navigationTemplates)
            @RenderPaletteSection("Logic", logicTemplates)
            @RenderPaletteSection("Safety", safetyTemplates)
        </aside>

        <section class="mission-canvas">
            <div class="chain">
                <div class="start-block block-shell">
                    @StartBlockSvg
                    <div class="block-line start-line">
                        <span>Start of chain</span>
                    </div>
                </div>

                <SortableList TItem="MissionBlock"
                              Items="missionBlocks"
                              ItemKey="BlockKey"
                              ContainerClass="mission-sortable-list"
                              ItemClass="mission-sortable-item"
                              PlaceholderClass="mission-sortable-placeholder"
                              Disabled="@isRunning"
                              OnMove="MoveMissionBlock"
                              OnExternalDrop="AddBlockFromPalette">
                    <EmptyContent>
                        <div class="insert-slot empty">Drop first block here</div>
                    </EmptyContent>
                    <ItemTemplate Context="block">
                        <article class="mission-block block-shell @(IsEndBlock(block.Kind) ? "end-block" : "") @(runningBlockId == block.Id ? "running" : "")">
                            @BlockShapeSvg(block.Kind)
                            <div class="block-line drag-handle">
                                @RenderBlockEditor(block)
                                <button class="remove-block" type="button" title="Remove block" @onclick="() => RemoveBlock(block.Id)" disabled="@isRunning">x</button>
                            </div>
                        </article>
                    </ItemTemplate>
                </SortableList>
            </div>
        </section>
    </main>

    <footer class="forge-status">
        <div>
            <span class="status-pill @(isConnected ? "online" : "offline")"></span>
            @status
        </div>
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <pre>@error</pre>
        }
    </footer>

    <aside class="gps-map-card" aria-label="Live GPS map">
        <div class="gps-map-title">
            <span>GPS Map</span>
            <strong>@GpsFixLabel</strong>
        </div>
        <div class="gps-map-frame">
            <svg class="gps-map" viewBox="0 0 240 160" role="img" aria-label="Drone position map">
                <defs>
                    <pattern id="gps-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                        <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#3f4e6f" stroke-width="0.8" />
                    </pattern>
                    <radialGradient id="gps-glow" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.45" />
                        <stop offset="100%" stop-color="#8fd4ff" stop-opacity="0" />
                    </radialGradient>
                </defs>
                <rect width="240" height="160" rx="6" fill="#182235" />
                <rect width="240" height="160" rx="6" fill="url(#gps-grid)" />
                <line x1="120" y1="12" x2="120" y2="148" class="gps-axis" />
                <line x1="12" y1="80" x2="228" y2="80" class="gps-axis" />
                @MapNorthLabelSvg

                @if (HasMapPosition)
                {
                    <circle class="gps-home-ring" cx="@MapHomeX" cy="@MapHomeY" r="7" />
                    <circle class="gps-home-dot" cx="@MapHomeX" cy="@MapHomeY" r="3" />

                    @if (!string.IsNullOrWhiteSpace(MapPathPoints))
                    {
                        <polyline class="gps-trail" points="@MapPathPoints" />
                    }

                    <line class="gps-heading" x1="@DroneMapX" y1="@DroneMapY" x2="@DroneHeadingX" y2="@DroneHeadingY" />
                    <circle class="gps-drone-glow" cx="@DroneMapX" cy="@DroneMapY" r="18" />
                    <circle class="gps-drone-marker" cx="@DroneMapX" cy="@DroneMapY" r="6" />
                }
                else
                {
                    @MapWaitingLabelSvg
                }
            </svg>
        </div>
        <div class="gps-map-readout">
            <span><b>LAT</b>@LatitudeLabel</span>
            <span><b>LON</b>@LongitudeLabel</span>
            <span><b>SPAN</b>@MapRangeLabel</span>
        </div>
    </aside>
</div>

@code {
    private readonly CancellationTokenSource telemetryCancellation = new();
    private CancellationTokenSource? missionCancellation;
    private readonly List<MissionBlock> missionBlocks = new();
    private List<SavedRouteSummary> savedRoutes = new();
    private readonly List<MapTrailPoint> gpsTrail = new();
    private MapTrailPoint? latestMapPoint;
    private double? mapOriginLatitude;
    private double? mapOriginLongitude;
    private double? mapOriginLocalX;
    private double? mapOriginLocalY;

    private const double MapWidth = 240.0;
    private const double MapHeight = 160.0;
    private const double MapPadding = 20.0;

    private readonly BlockTemplate[] movementTemplates =
    [
        new(BlockKind.Arm, "Arm motors"),
        new(BlockKind.Takeoff, "Takeoff to ...m"),
        new(BlockKind.Fly, "Fly ... at ...m/s for ...s"),
        new(BlockKind.Turn, "Turn ..."),
        new(BlockKind.ChangeAltitude, "Change altitude to ...m"),
        new(BlockKind.Hover, "Hold for ...s"),
        new(BlockKind.Land, "Land on ground"),
        new(BlockKind.Disarm, "Dearm motors"),
    ];

    private readonly BlockTemplate[] navigationTemplates =
    [
        new(BlockKind.GotoGps, "Fly GPS ..."),
        new(BlockKind.GotoLocal, "Fly local ..."),
        new(BlockKind.ReturnHome, "Return home"),
    ];

    private readonly BlockTemplate[] logicTemplates =
    [
        new(BlockKind.Wait, "Wait for ... seconds"),
        new(BlockKind.WaitUntilAltitude, "Wait altitude ...m"),
        new(BlockKind.WaitUntilGpsFix, "Wait GPS fix"),
        new(BlockKind.RepeatNext, "Repeat ... times"),
        new(BlockKind.IfBatteryBelow, "If battery < ...%"),
    ];

    private readonly BlockTemplate[] safetyTemplates =
    [
        new(BlockKind.FailsafeReturn, "Failsafe: Return"),
        new(BlockKind.FailsafeLand, "Failsafe: Land"),
    ];

    private string status = "Ready";
    private string error = "";
    private string selectedMode = "GUIDED";
    private string selectedRouteId = "";
    private string routeName = "";
    private Guid? runningBlockId;
    private TelemetrySnapshot telemetry = new();
    private bool isRunning;
    private bool isConnected;
    private bool isConnecting;
    private bool isChangingMode;
    private bool isLoadingRoutes;
    private bool isSavingRoute;

    private readonly string[] selectableModes =
    [
        "GUIDED",
        "STABILIZE",
        "ALT_HOLD",
        "LOITER",
        "AUTO",
        "RTL",
        "LAND",
    ];

    private string AltitudeLabel => FormattableString.Invariant($"{telemetry.AltitudeMeters:0.0}m");
    private string LatitudeLabel => telemetry.Latitude is null ? "--" : FormattableString.Invariant($"{telemetry.Latitude.Value:0.0000000}");
    private string LongitudeLabel => telemetry.Longitude is null ? "--" : FormattableString.Invariant($"{telemetry.Longitude.Value:0.0000000}");
    private string GpsFixLabel => telemetry.GpsFixType <= 0 ? $"NO FIX / {telemetry.SatellitesVisible} SAT" : $"{telemetry.GpsFixType} / {telemetry.SatellitesVisible} SAT";
    private string ModeLabel => string.IsNullOrWhiteSpace(telemetry.Mode) ? "UNKNOWN" : telemetry.Mode;
    private string ArmLabel => telemetry.Armed ? "ARMED" : "UNARMED";
    private string ConnectButtonLabel => isConnecting ? "CONNECTING" : isConnected ? "DISCONNECT" : "CONNECT";
    private bool CanRunMission => isConnected && !isRunning && missionBlocks.Count > 0;
    private bool CanOptimizeGpsRoute => !isRunning && missionBlocks.Count(block => block.Kind == BlockKind.GotoGps) >= 2;
    private bool HasMapPosition => latestMapPoint is not null;
    private string MapPathPoints => gpsTrail.Count < 2 ? string.Empty : string.Join(" ", gpsTrail.Select(point => FormatSvgPoint(ProjectMapPoint(point))));
    private string MapHomeX => gpsTrail.Count == 0 ? SvgNumber(MapWidth / 2.0) : SvgNumber(ProjectMapPoint(gpsTrail[0]).X);
    private string MapHomeY => gpsTrail.Count == 0 ? SvgNumber(MapHeight / 2.0) : SvgNumber(ProjectMapPoint(gpsTrail[0]).Y);
    private string DroneMapX => latestMapPoint is null ? SvgNumber(MapWidth / 2.0) : SvgNumber(ProjectMapPoint(latestMapPoint).X);
    private string DroneMapY => latestMapPoint is null ? SvgNumber(MapHeight / 2.0) : SvgNumber(ProjectMapPoint(latestMapPoint).Y);
    private string DroneHeadingX => SvgNumber(ProjectHeadingEnd().X);
    private string DroneHeadingY => SvgNumber(ProjectHeadingEnd().Y);
    private string MapRangeLabel => HasMapPosition ? FormattableString.Invariant($"{GetMapVisibleSpanMeters():0.#}m") : "--";

    protected override async Task OnInitializedAsync()
    {
        _ = PollTelemetryAsync(telemetryCancellation.Token);
        await LoadSavedRoutesAsync();
        await SaveLogAsync("Procedure", "Procedure page opened");
    }

    private RenderFragment RenderPaletteSection(string title, IReadOnlyList<BlockTemplate> templates) => @<section class="palette-section">
        <h2>@title</h2>
        @foreach (var template in templates)
        {
            <div class="palette-block block-shell" role="button" tabindex="0" data-sortable-template-kind="@template.Kind" aria-label="@template.Label">
                @NormalBlockSvg
                <span>@template.Label</span>
            </div>
        }
    </section>;

    private static string BlockKey(MissionBlock block)
    {
        return block.Id.ToString("N");
    }

    private void AddBlockFromPalette(SortableListExternalDropEventArgs args)
    {
        if (isRunning)
        {
            return;
        }

        if (!Enum.TryParse<BlockKind>(args.Payload, out var kind))
        {
            return;
        }

        missionBlocks.Insert(Math.Clamp(args.NewIndex, 0, missionBlocks.Count), CreateBlock(kind));
    }

    private void MoveMissionBlock(SortableListMoveEventArgs args)
    {
        if (isRunning)
        {
            return;
        }

        var currentIndex = missionBlocks.FindIndex(block => BlockKey(block) == args.ItemId);
        if (currentIndex < 0)
        {
            return;
        }

        var movedBlock = missionBlocks[currentIndex];
        missionBlocks.RemoveAt(currentIndex);
        var targetIndex = Math.Clamp(args.NewIndex, 0, missionBlocks.Count);

        if (currentIndex == targetIndex)
        {
            missionBlocks.Insert(currentIndex, movedBlock);
            return;
        }

        missionBlocks.Insert(targetIndex, movedBlock);
    }

    private static MissionBlock CreateBlock(BlockKind kind)
    {
        return kind switch
        {
            BlockKind.Takeoff => new MissionBlock(kind) { Altitude = 5.0, TimeoutSeconds = 45.0 },
            BlockKind.Fly => new MissionBlock(kind) { Direction = FlightDirection.Forward, Speed = 0.5, Seconds = 2.0 },
            BlockKind.Turn => new MissionBlock(kind) { Degrees = 90.0, Speed = 35.0, Tolerance = 8.0, TimeoutSeconds = 20.0 },
            BlockKind.ChangeAltitude => new MissionBlock(kind) { Altitude = 5.0, Speed = 0.4, Tolerance = 0.25, TimeoutSeconds = 30.0 },
            BlockKind.Hover => new MissionBlock(kind) { Seconds = 3.0 },
            BlockKind.GotoGps => new MissionBlock(kind) { Latitude = 47.397742, Longitude = 8.545594, Altitude = 5.0, Radius = 2.0, TimeoutSeconds = 90.0 },
            BlockKind.GotoLocal => new MissionBlock(kind) { LocalX = 5.0, LocalY = 0.0, Altitude = 5.0, Radius = 0.75, TimeoutSeconds = 45.0 },
            BlockKind.Wait => new MissionBlock(kind) { Seconds = 1.0 },
            BlockKind.WaitUntilAltitude => new MissionBlock(kind) { Altitude = 5.0, Tolerance = 0.25, TimeoutSeconds = 45.0 },
            BlockKind.WaitUntilGpsFix => new MissionBlock(kind) { Count = 6, TimeoutSeconds = 30.0 },
            BlockKind.RepeatNext => new MissionBlock(kind) { Count = 2 },
            BlockKind.IfBatteryBelow => new MissionBlock(kind) { Percent = 25 },
            _ => new MissionBlock(kind),
        };
    }

    private void RemoveBlock(Guid id)
    {
        if (isRunning)
        {
            return;
        }

        missionBlocks.RemoveAll(block => block.Id == id);
    }

    private async Task OptimizeGpsRouteAsync()
    {
        if (!CanOptimizeGpsRoute)
        {
            return;
        }

        var gpsSlots = missionBlocks
            .Select((block, index) => new GpsBlockSlot(index, block))
            .Where(slot => slot.Block.Kind == BlockKind.GotoGps)
            .ToList();

        if (gpsSlots.Count < 2)
        {
            return;
        }

        var gpsBlocks = gpsSlots.Select(slot => slot.Block).ToList();
        var start = GetGpsOptimizationStart(gpsBlocks[0]);
        var originalDistance = PathDistanceMeters(start, gpsBlocks);
        var optimizedBlocks = GetOptimizedGpsOrder(gpsBlocks, start);

        for (var index = 0; index < gpsSlots.Count; index++)
        {
            missionBlocks[gpsSlots[index].Index] = optimizedBlocks[index];
        }

        var optimizedDistance = PathDistanceMeters(start, optimizedBlocks);
        status = FormattableString.Invariant($"GPS route optimized: {originalDistance:0.#}m -> {optimizedDistance:0.#}m");
        error = "";

        await SaveLogAsync(
            "Route",
            "Optimized GPS route",
            FormattableString.Invariant($"{gpsSlots.Count} waypoints, {originalDistance:0.#}m -> {optimizedDistance:0.#}m"));
    }

    private GpsCoordinate GetGpsOptimizationStart(MissionBlock firstGpsBlock)
    {
        if (telemetry.Latitude is not null && telemetry.Longitude is not null)
        {
            return new GpsCoordinate(telemetry.Latitude.Value, telemetry.Longitude.Value);
        }

        return ToGpsCoordinate(firstGpsBlock);
    }

    private static List<MissionBlock> GetOptimizedGpsOrder(IReadOnlyList<MissionBlock> blocks, GpsCoordinate start)
    {
        if (blocks.Count <= 12)
        {
            return GetExactShortestGpsOrder(blocks, start);
        }

        var order = GetNearestNeighborGpsOrder(blocks, start);
        ImproveGpsOrderWithTwoOpt(order, start);
        return order;
    }

    private static List<MissionBlock> GetExactShortestGpsOrder(IReadOnlyList<MissionBlock> blocks, GpsCoordinate start)
    {
        var count = blocks.Count;
        var stateCount = 1 << count;
        var distances = BuildGpsDistanceMatrix(blocks);
        var startDistances = blocks.Select(block => DistanceMeters(start, ToGpsCoordinate(block))).ToArray();
        var costs = new double[stateCount, count];
        var parents = new int[stateCount, count];

        for (var mask = 0; mask < stateCount; mask++)
        {
            for (var last = 0; last < count; last++)
            {
                costs[mask, last] = double.PositiveInfinity;
                parents[mask, last] = -1;
            }
        }

        for (var index = 0; index < count; index++)
        {
            costs[1 << index, index] = startDistances[index];
        }

        for (var mask = 1; mask < stateCount; mask++)
        {
            for (var last = 0; last < count; last++)
            {
                if ((mask & (1 << last)) == 0)
                {
                    continue;
                }

                var previousMask = mask ^ (1 << last);
                if (previousMask == 0)
                {
                    continue;
                }

                for (var previous = 0; previous < count; previous++)
                {
                    if ((previousMask & (1 << previous)) == 0)
                    {
                        continue;
                    }

                    var candidate = costs[previousMask, previous] + distances[previous, last];
                    if (candidate < costs[mask, last])
                    {
                        costs[mask, last] = candidate;
                        parents[mask, last] = previous;
                    }
                }
            }
        }

        var fullMask = stateCount - 1;
        var bestLast = 0;
        var bestCost = double.PositiveInfinity;

        for (var last = 0; last < count; last++)
        {
            if (costs[fullMask, last] < bestCost)
            {
                bestCost = costs[fullMask, last];
                bestLast = last;
            }
        }

        var orderIndices = new int[count];
        var currentMask = fullMask;
        var currentLast = bestLast;

        for (var position = count - 1; position >= 0; position--)
        {
            orderIndices[position] = currentLast;
            var previous = parents[currentMask, currentLast];
            currentMask ^= 1 << currentLast;
            currentLast = previous;
        }

        return orderIndices.Select(index => blocks[index]).ToList();
    }

    private static List<MissionBlock> GetNearestNeighborGpsOrder(IReadOnlyList<MissionBlock> blocks, GpsCoordinate start)
    {
        var remaining = Enumerable.Range(0, blocks.Count).ToList();
        var order = new List<MissionBlock>(blocks.Count);
        var current = start;

        while (remaining.Count > 0)
        {
            var bestRemainingIndex = 0;
            var bestDistance = double.PositiveInfinity;

            for (var index = 0; index < remaining.Count; index++)
            {
                var candidateIndex = remaining[index];
                var distance = DistanceMeters(current, ToGpsCoordinate(blocks[candidateIndex]));
                if (distance < bestDistance)
                {
                    bestDistance = distance;
                    bestRemainingIndex = index;
                }
            }

            var nextBlock = blocks[remaining[bestRemainingIndex]];
            order.Add(nextBlock);
            current = ToGpsCoordinate(nextBlock);
            remaining.RemoveAt(bestRemainingIndex);
        }

        return order;
    }

    private static void ImproveGpsOrderWithTwoOpt(List<MissionBlock> order, GpsCoordinate start)
    {
        var improved = true;

        while (improved)
        {
            improved = false;

            for (var first = 0; first < order.Count - 1; first++)
            {
                for (var second = first + 1; second < order.Count; second++)
                {
                    var previous = first == 0 ? start : ToGpsCoordinate(order[first - 1]);
                    var firstPoint = ToGpsCoordinate(order[first]);
                    var secondPoint = ToGpsCoordinate(order[second]);
                    var after = second + 1 < order.Count ? ToGpsCoordinate(order[second + 1]) : (GpsCoordinate?)null;

                    var currentDistance = DistanceMeters(previous, firstPoint);
                    var reversedDistance = DistanceMeters(previous, secondPoint);

                    if (after is not null)
                    {
                        currentDistance += DistanceMeters(secondPoint, after.Value);
                        reversedDistance += DistanceMeters(firstPoint, after.Value);
                    }

                    if (reversedDistance + 0.01 >= currentDistance)
                    {
                        continue;
                    }

                    order.Reverse(first, second - first + 1);
                    improved = true;
                }
            }
        }
    }

    private static double[,] BuildGpsDistanceMatrix(IReadOnlyList<MissionBlock> blocks)
    {
        var distances = new double[blocks.Count, blocks.Count];

        for (var first = 0; first < blocks.Count; first++)
        {
            for (var second = 0; second < blocks.Count; second++)
            {
                distances[first, second] = first == second
                    ? 0.0
                    : DistanceMeters(ToGpsCoordinate(blocks[first]), ToGpsCoordinate(blocks[second]));
            }
        }

        return distances;
    }

    private static double PathDistanceMeters(GpsCoordinate start, IReadOnlyList<MissionBlock> blocks)
    {
        var distance = 0.0;
        var current = start;

        foreach (var block in blocks)
        {
            var next = ToGpsCoordinate(block);
            distance += DistanceMeters(current, next);
            current = next;
        }

        return distance;
    }

    private static GpsCoordinate ToGpsCoordinate(MissionBlock block)
    {
        return new GpsCoordinate(block.Latitude, block.Longitude);
    }

    private async Task LoadSavedRoutesAsync()
    {
        isLoadingRoutes = true;

        try
        {
            savedRoutes = (await Storage.GetRoutesAsync()).ToList();
        }
        catch (Exception exception)
        {
            error = exception.Message;
            status = "Route DB load failed";
        }
        finally
        {
            isLoadingRoutes = false;
        }
    }

    private async Task LoadRouteSelectionAsync(ChangeEventArgs args)
    {
        selectedRouteId = args.Value?.ToString() ?? "";
        if (!int.TryParse(selectedRouteId, out var routeId))
        {
            return;
        }

        try
        {
            var route = await Storage.GetRouteAsync(routeId);
            if (route is null)
            {
                status = "Route not found";
                return;
            }

            ApplyRouteJson(route.RouteJson);
            routeName = route.Name;
            status = $"Route loaded: {route.Name}";
            await SaveLogAsync("Route", $"Loaded route '{route.Name}'");
        }
        catch (Exception exception)
        {
            status = "Route load failed";
            error = exception.Message;
            await SaveLogAsync("Route", "Route load failed", exception.Message);
        }
    }

    private async Task SaveRouteAsync()
    {
        if (isRunning || missionBlocks.Count == 0)
        {
            return;
        }

        isSavingRoute = true;
        error = "";

        try
        {
            var name = string.IsNullOrWhiteSpace(routeName)
                ? $"Route {DateTime.Now:yyyy-MM-dd HH:mm}"
                : routeName.Trim();

            var routeId = int.TryParse(selectedRouteId, out var parsedRouteId) ? parsedRouteId : (int?)null;
            var savedId = await Storage.SaveRouteAsync(routeId, name, SerializeRouteJson());

            routeName = name;
            selectedRouteId = savedId.ToString();
            await LoadSavedRoutesAsync();
            selectedRouteId = savedId.ToString();

            status = $"Route saved: {name}";
            await SaveLogAsync("Route", $"Saved route '{name}'");
        }
        catch (Exception exception)
        {
            status = "Route save failed";
            error = exception.Message;
            await SaveLogAsync("Route", "Route save failed", exception.Message);
        }
        finally
        {
            isSavingRoute = false;
        }
    }

    private string SerializeRouteJson()
    {
        var blocks = missionBlocks.Select(block => new StoredMissionBlock
        {
            Kind = block.Kind.ToString(),
            Altitude = block.Altitude,
            Speed = block.Speed,
            Seconds = block.Seconds,
            Degrees = block.Degrees,
            Latitude = block.Latitude,
            Longitude = block.Longitude,
            LocalX = block.LocalX,
            LocalY = block.LocalY,
            Radius = block.Radius,
            Tolerance = block.Tolerance,
            TimeoutSeconds = block.TimeoutSeconds,
            Count = block.Count,
            Percent = block.Percent,
            Direction = block.Direction.ToString(),
        });

        return System.Text.Json.JsonSerializer.Serialize(blocks);
    }

    private void ApplyRouteJson(string routeJson)
    {
        var blocks = System.Text.Json.JsonSerializer.Deserialize<List<StoredMissionBlock>>(routeJson) ?? [];

        missionBlocks.Clear();
        foreach (var storedBlock in blocks)
        {
            if (!Enum.TryParse<BlockKind>(storedBlock.Kind, out var kind))
            {
                continue;
            }

            var block = CreateBlock(kind);
            block.Altitude = storedBlock.Altitude;
            block.Speed = storedBlock.Speed;
            block.Seconds = storedBlock.Seconds;
            block.Degrees = storedBlock.Degrees;
            block.Latitude = storedBlock.Latitude;
            block.Longitude = storedBlock.Longitude;
            block.LocalX = storedBlock.LocalX;
            block.LocalY = storedBlock.LocalY;
            block.Radius = storedBlock.Radius;
            block.Tolerance = storedBlock.Tolerance;
            block.TimeoutSeconds = storedBlock.TimeoutSeconds;
            block.Count = storedBlock.Count;
            block.Percent = storedBlock.Percent;

            if (Enum.TryParse<FlightDirection>(storedBlock.Direction, out var direction))
            {
                block.Direction = direction;
            }

            missionBlocks.Add(block);
        }
    }

    private async Task SaveLogAsync(string category, string message, string? details = null)
    {
        try
        {
            await Storage.AddLogAsync(category, message, details);
        }
        catch
        {
        }
    }

    private async Task ToggleConnectionAsync()
    {
        if (isConnecting || isRunning)
        {
            return;
        }

        error = "";
        isConnecting = true;

        try
        {
            if (isConnected)
            {
                await EnsureSuccess("Disconnect", Drone.Disconnect());
                isConnected = false;
                status = "Disconnected";
                await SaveLogAsync("Connection", "Disconnected");
                return;
            }

            status = "Connecting";
            await EnsureSuccess("Connect", Drone.Connect());
            await RefreshTelemetryAsync();
            status = isConnected ? "Connected" : "Connect sent";
            await SaveLogAsync("Connection", status);
        }
        catch (Exception exception)
        {
            status = isConnected ? "Disconnect failed" : "Connect failed";
            error = exception.Message;
            await SaveLogAsync("Connection", status, exception.Message);
        }
        finally
        {
            isConnecting = false;
        }
    }

    private async Task ChangeModeAsync(ChangeEventArgs args)
    {
        var newMode = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(newMode))
        {
            return;
        }

        selectedMode = newMode;
        if (!isConnected || isRunning || isChangingMode)
        {
            return;
        }

        error = "";
        isChangingMode = true;

        try
        {
            await EnsureSuccess($"Set mode {newMode}", Drone.SetMode(newMode));
            status = $"Mode set: {newMode}";
            await RefreshTelemetryAsync();
            await SaveLogAsync("Mode", status);
        }
        catch (Exception exception)
        {
            status = "Mode change failed";
            error = exception.Message;
            await SaveLogAsync("Mode", $"Mode change failed: {newMode}", exception.Message);
        }
        finally
        {
            isChangingMode = false;
        }
    }

    private async Task RunMissionAsync()
    {
        if (!CanRunMission)
        {
            return;
        }

        error = "";
        status = "Mission running";
        isRunning = true;
        missionCancellation = new CancellationTokenSource();
        var token = missionCancellation.Token;
        await SaveLogAsync("Mission", "Mission started", SerializeRouteJson());

        try
        {
            for (var index = 0; index < missionBlocks.Count; index++)
            {
                token.ThrowIfCancellationRequested();
                var block = missionBlocks[index];

                if (block.Kind == BlockKind.RepeatNext)
                {
                    if (index + 1 >= missionBlocks.Count)
                    {
                        continue;
                    }

                    var nextBlock = missionBlocks[index + 1];
                    for (var repeat = 0; repeat < Math.Max(1, block.Count); repeat++)
                    {
                        token.ThrowIfCancellationRequested();
                        await ExecuteBlockAsync(nextBlock, token);
                    }

                    index++;
                    continue;
                }

                await ExecuteBlockAsync(block, token);
            }

            runningBlockId = null;
            status = "Mission finished";
            await SaveLogAsync("Mission", "Mission finished");
        }
        catch (OperationCanceledException)
        {
            runningBlockId = null;
            status = "Mission aborted";
            await SaveLogAsync("Mission", "Mission aborted");
        }
        catch (Exception exception)
        {
            runningBlockId = null;
            status = "Mission failed";
            error = exception.Message;
            await SaveLogAsync("Mission", "Mission failed", exception.Message);
        }
        finally
        {
            isRunning = false;
            missionCancellation?.Dispose();
            missionCancellation = null;
            await RefreshTelemetryAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ExecuteBlockAsync(MissionBlock block, CancellationToken token)
    {
        runningBlockId = block.Id;
        status = $"Running: {BlockTitle(block)}";
        await SaveLogAsync("Block", $"Started {BlockTitle(block)}");
        await InvokeAsync(StateHasChanged);

        switch (block.Kind)
        {
            case BlockKind.Arm:
                await EnsureSuccess("Guided mode", Drone.SetMode("GUIDED"));
                await EnsureSuccess("Arm motors", Drone.Arm());
                await WaitUntilAsync("armed", () => telemetry.Armed, TimeSpan.FromSeconds(10), token);
                break;
            case BlockKind.Takeoff:
                await EnsureSuccess("Takeoff", Drone.Takeoff(block.Altitude, armFirst: true));
                await WaitUntilAltitudeAsync(block.Altitude, block.ToleranceOrDefault(0.25), TimeSpan.FromSeconds(block.TimeoutSecondsOrDefault(45)), token);
                break;
            case BlockKind.Fly:
                var (vx, vy, vz) = VelocityFor(block.Direction, block.Speed);
                await EnsureSuccess("Fly", Drone.SendVelocity(vx, vy, vz, block.Seconds));
                break;
            case BlockKind.Turn:
                await TurnAndWaitAsync(block, token);
                break;
            case BlockKind.ChangeAltitude:
                await ChangeAltitudeAsync(block, token);
                break;
            case BlockKind.Hover:
                await EnsureSuccess("Hold position", Drone.SendVelocity(0, 0, 0, 0.1));
                await DelayWithTelemetryAsync(TimeSpan.FromSeconds(Math.Max(0, block.Seconds)), token);
                break;
            case BlockKind.GotoGps:
                await EnsureSuccess("Go to GPS", Drone.GotoGlobal(block.Latitude, block.Longitude, block.Altitude));
                await WaitUntilGpsTargetAsync(block, token);
                break;
            case BlockKind.GotoLocal:
                await EnsureSuccess("Go to local position", Drone.GotoLocal(block.LocalX, block.LocalY, -Math.Abs(block.Altitude)));
                await WaitUntilLocalTargetAsync(block, token);
                break;
            case BlockKind.ReturnHome:
                await EnsureSuccess("Return home", Drone.Rtl());
                await WaitUntilModeAsync("RTL", TimeSpan.FromSeconds(8), token);
                break;
            case BlockKind.Land:
                await EnsureSuccess("Land", Drone.Land());
                await WaitUntilAltitudeAsync(0.2, 0.35, TimeSpan.FromSeconds(75), token);
                break;
            case BlockKind.Disarm:
                await EnsureSuccess("Disarm", Drone.Disarm());
                await WaitUntilAsync("disarmed", () => !telemetry.Armed, TimeSpan.FromSeconds(10), token);
                break;
            case BlockKind.Wait:
                await DelayWithTelemetryAsync(TimeSpan.FromSeconds(Math.Max(0, block.Seconds)), token);
                break;
            case BlockKind.WaitUntilAltitude:
                await WaitUntilAltitudeAsync(block.Altitude, block.ToleranceOrDefault(0.25), TimeSpan.FromSeconds(block.TimeoutSecondsOrDefault(45)), token);
                break;
            case BlockKind.WaitUntilGpsFix:
                await WaitUntilAsync(
                    "GPS fix",
                    () => telemetry.GpsFixType >= 3 && telemetry.SatellitesVisible >= Math.Max(1, block.Count),
                    TimeSpan.FromSeconds(block.TimeoutSecondsOrDefault(30)),
                    token);
                break;
            case BlockKind.IfBatteryBelow:
                await RefreshTelemetryAsync();
                if (telemetry.BatteryPercent < block.Percent)
                {
                    await EnsureSuccess("Battery failsafe return", Drone.Rtl());
                    throw new OperationCanceledException(token);
                }
                break;
            case BlockKind.FailsafeReturn:
                await EnsureSuccess("Failsafe return", Drone.Rtl());
                throw new OperationCanceledException(token);
            case BlockKind.FailsafeLand:
                await AbortMissionAsync();
                throw new OperationCanceledException(token);
        }

        await RefreshTelemetryAsync();
        await SaveLogAsync("Block", $"Finished {BlockTitle(block)}");
    }

    private async Task TurnAndWaitAsync(MissionBlock block, CancellationToken token)
    {
        await RefreshTelemetryAsync();
        var startHeading = telemetry.HeadingDegrees;
        await EnsureSuccess("Turn", Drone.Yaw(block.Degrees, block.Speed, isRelative: true));

        if (startHeading is null)
        {
            var fallbackSeconds = Math.Clamp(Math.Abs(block.Degrees) / Math.Max(1.0, block.Speed), 0.4, block.TimeoutSecondsOrDefault(20));
            await DelayWithTelemetryAsync(TimeSpan.FromSeconds(fallbackSeconds), token);
            return;
        }

        var targetHeading = NormalizeHeading(startHeading.Value + block.Degrees);
        await WaitUntilAsync(
            "target heading",
            () => telemetry.HeadingDegrees is not null && HeadingDelta(telemetry.HeadingDegrees.Value, targetHeading) <= block.ToleranceOrDefault(8.0),
            TimeSpan.FromSeconds(block.TimeoutSecondsOrDefault(20)),
            token);
    }

    private async Task ChangeAltitudeAsync(MissionBlock block, CancellationToken token)
    {
        var timeout = TimeSpan.FromSeconds(block.TimeoutSecondsOrDefault(30));
        var deadline = DateTimeOffset.UtcNow + timeout;
        var tolerance = block.ToleranceOrDefault(0.25);
        var speed = Math.Clamp(Math.Abs(block.Speed), 0.1, 1.0);

        try
        {
            while (DateTimeOffset.UtcNow < deadline)
            {
                token.ThrowIfCancellationRequested();
                await RefreshTelemetryAsync();

                var delta = block.Altitude - telemetry.AltitudeMeters;
                if (Math.Abs(delta) <= tolerance)
                {
                    return;
                }

                var vz = delta > 0 ? -speed : speed;
                await EnsureSuccess("Change altitude", Drone.SendVelocity(0, 0, vz, 0.35));
            }

            throw new TimeoutException($"Altitude target {block.Altitude:0.0}m not reached. Current altitude: {telemetry.AltitudeMeters:0.0}m.");
        }
        finally
        {
            if (isConnected)
            {
                await Drone.SendVelocity(0, 0, 0, 0.1);
            }
        }
    }

    private async Task WaitUntilAltitudeAsync(double targetAltitude, double tolerance, TimeSpan timeout, CancellationToken token)
    {
        await WaitUntilAsync(
            $"altitude {targetAltitude:0.0}m",
            () => Math.Abs(telemetry.AltitudeMeters - targetAltitude) <= tolerance,
            timeout,
            token);
    }

    private async Task WaitUntilGpsTargetAsync(MissionBlock block, CancellationToken token)
    {
        await WaitUntilAsync(
            "GPS target",
            () =>
            {
                if (telemetry.Latitude is null || telemetry.Longitude is null)
                {
                    return false;
                }

                var distance = DistanceMeters(telemetry.Latitude.Value, telemetry.Longitude.Value, block.Latitude, block.Longitude);
                return distance <= Math.Max(0.5, block.Radius)
                    && Math.Abs(telemetry.AltitudeMeters - block.Altitude) <= 0.75;
            },
            TimeSpan.FromSeconds(block.TimeoutSecondsOrDefault(90)),
            token);
    }

    private async Task WaitUntilLocalTargetAsync(MissionBlock block, CancellationToken token)
    {
        await WaitUntilAsync(
            "local target",
            () =>
            {
                if (telemetry.LocalX is null || telemetry.LocalY is null)
                {
                    return false;
                }

                var distance = Math.Sqrt(Math.Pow(telemetry.LocalX.Value - block.LocalX, 2) + Math.Pow(telemetry.LocalY.Value - block.LocalY, 2));
                return distance <= Math.Max(0.25, block.Radius)
                    && Math.Abs(telemetry.AltitudeMeters - block.Altitude) <= 0.75;
            },
            TimeSpan.FromSeconds(block.TimeoutSecondsOrDefault(45)),
            token);
    }

    private async Task WaitUntilModeAsync(string mode, TimeSpan timeout, CancellationToken token)
    {
        await WaitUntilAsync(
            mode,
            () => string.Equals(telemetry.Mode, mode, StringComparison.OrdinalIgnoreCase),
            timeout,
            token);
    }

    private async Task WaitUntilAsync(string label, Func<bool> condition, TimeSpan timeout, CancellationToken token)
    {
        var deadline = DateTimeOffset.UtcNow + timeout;
        while (DateTimeOffset.UtcNow < deadline)
        {
            token.ThrowIfCancellationRequested();
            await RefreshTelemetryAsync();
            await InvokeAsync(StateHasChanged);

            if (condition())
            {
                return;
            }

            await Task.Delay(250, token);
        }

        throw new TimeoutException($"Timed out while waiting for {label}.");
    }

    private async Task DelayWithTelemetryAsync(TimeSpan delay, CancellationToken token)
    {
        var deadline = DateTimeOffset.UtcNow + delay;
        while (DateTimeOffset.UtcNow < deadline)
        {
            token.ThrowIfCancellationRequested();
            await RefreshTelemetryAsync();
            await Task.Delay(TimeSpan.FromMilliseconds(250), token);
        }
    }

    private async Task AbortMissionAsync()
    {
        missionCancellation?.Cancel();
        error = "";
        status = "Abort requested";
        runningBlockId = null;
        await SaveLogAsync("Mission", "Abort requested");

        if (isConnected)
        {
            await Drone.SendVelocity(0, 0, 0, 0.1);
            await Drone.Land();
        }
    }

    private async Task EnsureSuccess(string label, Task<DroneApiService.ApiResponse<object>> action)
    {
        var result = await action;
        if (result.Success)
        {
            return;
        }

        throw new InvalidOperationException($"{label} failed: {CombineError(result.ErrorMessage, result.ResponseBody)}");
    }

    private static (double Vx, double Vy, double Vz) VelocityFor(FlightDirection direction, double speed)
    {
        var amount = Math.Clamp(speed, 0.0, 1.0);
        return direction switch
        {
            FlightDirection.Back => (-amount, 0, 0),
            FlightDirection.Left => (0, -amount, 0),
            FlightDirection.Right => (0, amount, 0),
            FlightDirection.Up => (0, 0, -amount),
            FlightDirection.Down => (0, 0, amount),
            _ => (amount, 0, 0),
        };
    }

    private async Task PollTelemetryAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));

        while (!token.IsCancellationRequested)
        {
            try
            {
                await RefreshTelemetryAsync();
                await InvokeAsync(StateHasChanged);
                await timer.WaitForNextTickAsync(token);
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch
            {
                await Task.Delay(1000, token);
            }
        }
    }

    private async Task RefreshTelemetryAsync()
    {
        try
        {
            var json = await Drone.GetStatus();
            telemetry = TelemetrySnapshot.FromJson(json);
            isConnected = telemetry.Connected;

            if (!isChangingMode
                && !string.IsNullOrWhiteSpace(telemetry.Mode)
                && selectableModes.Contains(telemetry.Mode, StringComparer.OrdinalIgnoreCase))
            {
                selectedMode = telemetry.Mode;
            }

            CaptureGpsTrailPoint();
        }
        catch
        {
            isConnected = false;
        }
    }

    private void CaptureGpsTrailPoint()
    {
        if (telemetry.Latitude is null || telemetry.Longitude is null)
        {
            return;
        }

        mapOriginLatitude ??= telemetry.Latitude.Value;
        mapOriginLongitude ??= telemetry.Longitude.Value;
        mapOriginLocalX ??= telemetry.LocalX;
        mapOriginLocalY ??= telemetry.LocalY;

        var (eastMeters, northMeters) = ToMapMeters();
        var point = new MapTrailPoint(eastMeters, northMeters, telemetry.HeadingDegrees);
        latestMapPoint = point;

        if (gpsTrail.Count == 0)
        {
            gpsTrail.Add(point);
            return;
        }

        var distance = DistanceMeters(gpsTrail[^1], point);
        if (distance >= 0.25)
        {
            gpsTrail.Add(point);
        }
        else if (gpsTrail.Count > 1)
        {
            gpsTrail[^1] = point;
        }

        while (gpsTrail.Count > 450)
        {
            gpsTrail.RemoveAt(1);
        }
    }

    private (double EastMeters, double NorthMeters) ToMapMeters()
    {
        if (telemetry.LocalX is not null
            && telemetry.LocalY is not null
            && mapOriginLocalX is not null
            && mapOriginLocalY is not null)
        {
            return (telemetry.LocalY.Value - mapOriginLocalY.Value, telemetry.LocalX.Value - mapOriginLocalX.Value);
        }

        var originLatitude = mapOriginLatitude ?? telemetry.Latitude ?? 0.0;
        var originLongitude = mapOriginLongitude ?? telemetry.Longitude ?? 0.0;
        var metersPerDegreeLatitude = 111_320.0;
        var metersPerDegreeLongitude = metersPerDegreeLatitude * Math.Cos(originLatitude * Math.PI / 180.0);
        var northMeters = ((telemetry.Latitude ?? originLatitude) - originLatitude) * metersPerDegreeLatitude;
        var eastMeters = ((telemetry.Longitude ?? originLongitude) - originLongitude) * metersPerDegreeLongitude;

        return (eastMeters, northMeters);
    }

    private (double X, double Y) ProjectMapPoint(MapTrailPoint point)
    {
        var bounds = GetMapBounds();
        var drawableWidth = MapWidth - (MapPadding * 2.0);
        var drawableHeight = MapHeight - (MapPadding * 2.0);
        var x = MapPadding + ((point.EastMeters - bounds.MinEast) / (bounds.MaxEast - bounds.MinEast) * drawableWidth);
        var y = MapHeight - MapPadding - ((point.NorthMeters - bounds.MinNorth) / (bounds.MaxNorth - bounds.MinNorth) * drawableHeight);

        return (x, y);
    }

    private (double X, double Y) ProjectHeadingEnd()
    {
        if (latestMapPoint is null)
        {
            return (MapWidth / 2.0, MapHeight / 2.0);
        }

        var start = ProjectMapPoint(latestMapPoint);
        var heading = latestMapPoint.HeadingDegrees ?? 0.0;
        var radians = heading * Math.PI / 180.0;

        return (start.X + Math.Sin(radians) * 18.0, start.Y - Math.Cos(radians) * 18.0);
    }

    private (double MinEast, double MaxEast, double MinNorth, double MaxNorth) GetMapBounds()
    {
        if (gpsTrail.Count == 0)
        {
            return (-10.0, 10.0, -10.0, 10.0);
        }

        var minEast = gpsTrail.Min(point => point.EastMeters);
        var maxEast = gpsTrail.Max(point => point.EastMeters);
        var minNorth = gpsTrail.Min(point => point.NorthMeters);
        var maxNorth = gpsTrail.Max(point => point.NorthMeters);

        ExpandToMapAspectRatio(ref minEast, ref maxEast, ref minNorth, ref maxNorth);

        return (minEast, maxEast, minNorth, maxNorth);
    }

    private static void ExpandToMapAspectRatio(ref double minEast, ref double maxEast, ref double minNorth, ref double maxNorth)
    {
        var eastSpan = Math.Max(maxEast - minEast, 10.0);
        var northSpan = Math.Max(maxNorth - minNorth, 10.0);
        var targetRatio = (MapWidth - (MapPadding * 2.0)) / (MapHeight - (MapPadding * 2.0));

        if (eastSpan / northSpan > targetRatio)
        {
            northSpan = eastSpan / targetRatio;
        }
        else
        {
            eastSpan = northSpan * targetRatio;
        }

        eastSpan *= 1.18;
        northSpan *= 1.18;

        var eastCenter = (minEast + maxEast) / 2.0;
        var northCenter = (minNorth + maxNorth) / 2.0;
        minEast = eastCenter - (eastSpan / 2.0);
        maxEast = eastCenter + (eastSpan / 2.0);
        minNorth = northCenter - (northSpan / 2.0);
        maxNorth = northCenter + (northSpan / 2.0);
    }

    private double GetMapVisibleSpanMeters()
    {
        var bounds = GetMapBounds();
        return Math.Max(bounds.MaxEast - bounds.MinEast, bounds.MaxNorth - bounds.MinNorth);
    }

    private static double DistanceMeters(MapTrailPoint first, MapTrailPoint second)
    {
        var east = first.EastMeters - second.EastMeters;
        var north = first.NorthMeters - second.NorthMeters;
        return Math.Sqrt((east * east) + (north * north));
    }

    private static string FormatSvgPoint((double X, double Y) point)
    {
        return $"{SvgNumber(point.X)},{SvgNumber(point.Y)}";
    }

    private static string SvgNumber(double value)
    {
        return value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    }

    private static string BlockTitle(MissionBlock block)
    {
        return block.Kind switch
        {
            BlockKind.Arm => "Arm motors",
            BlockKind.Takeoff => $"Takeoff to {block.Altitude:0.#}m",
            BlockKind.Fly => $"Fly {block.Direction} at {block.Speed:0.##}m/s for {block.Seconds:0.#}s",
            BlockKind.Turn => $"Turn {block.Degrees:0.#} deg",
            BlockKind.ChangeAltitude => $"Change altitude to {block.Altitude:0.#}m",
            BlockKind.Hover => $"Hold for {block.Seconds:0.#}s",
            BlockKind.GotoGps => $"Fly GPS {block.Latitude:0.000000}, {block.Longitude:0.000000}",
            BlockKind.GotoLocal => $"Fly local X {block.LocalX:0.#} Y {block.LocalY:0.#}",
            BlockKind.ReturnHome => "Return home",
            BlockKind.Land => "Land on ground",
            BlockKind.Disarm => "Dearm motors",
            BlockKind.Wait => $"Wait for {block.Seconds:0.#}s",
            BlockKind.WaitUntilAltitude => $"Wait altitude {block.Altitude:0.#}m",
            BlockKind.WaitUntilGpsFix => $"Wait GPS fix {block.Count} sats",
            BlockKind.RepeatNext => $"Repeat next {block.Count} times",
            BlockKind.IfBatteryBelow => $"If battery < {block.Percent:0}%",
            BlockKind.FailsafeReturn => "Failsafe return",
            BlockKind.FailsafeLand => "Failsafe land",
            _ => block.Kind.ToString(),
        };
    }

