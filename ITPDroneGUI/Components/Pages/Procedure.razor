        margin: -1.1rem -1.5rem 0;
        background: #d3d3d8;
        color: #f4f6fb;
        display: grid;
        grid-template-rows: 62px minmax(560px, 1fr) auto;
    }

    .forge-toolbar {
        display: grid;
        grid-template-columns: 260px 1fr 340px;
        align-items: center;
        gap: 18px;
        background: #202a42;
        border-bottom: 1px solid #303b58;
        padding: 0 16px;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 1.55rem;
        font-weight: 500;
    }

    .brand-mark {
        width: 28px;
        height: 28px;
        position: relative;
    }

    .brand-mark span {
        position: absolute;
        width: 12px;
        height: 12px;
        border: 3px solid #ffffff;
        border-radius: 999px;
    }

    .brand-mark span:nth-child(1) {
        left: 0;
        top: 0;
    }

    .brand-mark span:nth-child(2) {
        right: 0;
        top: 0;
    }

    .brand-mark span:nth-child(3) {
        left: 0;
        bottom: 0;
    }

    .brand-mark span:nth-child(4) {
        right: 0;
        bottom: 0;
    }

    .telemetry {
        display: flex;
        justify-content: center;
        gap: 60px;
        color: #ffffff;
        font-size: 1.25rem;
        font-weight: 800;
    }

    .mission-actions {
        display: flex;
        justify-content: flex-end;
        gap: 28px;
    }

    .run-button,
    .abort-button {
        min-width: 138px;
        height: 30px;
        border: 0;
        border-radius: 3px;
        color: #ffffff;
        font-size: 0.78rem;
        font-weight: 800;
    }

    .run-button {
        display: inline-flex;
