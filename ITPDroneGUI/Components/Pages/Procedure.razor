@page "/procedure"
@implements IAsyncDisposable
@using System.Text.Json
@inject DroneApiService Drone
@inject IJSRuntime Js

<PageTitle>DroneForge</PageTitle>

<div class="forge-page">
    <header class="forge-toolbar">
        <a class="brand" href="/" aria-label="Home">
            <span class="brand-logo" aria-hidden="true"><img src="droneforge-logo.svg" alt="" /></span>
            <span>DroneForge</span>
        </a>

        <div class="telemetry">
            <span>ALT: @AltitudeLabel</span>
            <span>MODE: @ModeLabel</span>
            <span>@ArmLabel</span>
        </div>

        <div class="mission-actions">
            <button class="connect-button" type="button" @onclick="ToggleConnectionAsync" disabled="@(isConnecting || isRunning)">
                @ConnectButtonLabel
            </button>
            <select class="mode-select" title="Flight mode" value="@selectedMode" @onchange="ChangeModeAsync" disabled="@(!isConnected || isRunning || isChangingMode)">
                @foreach (var mode in selectableModes)
                {
                    <option value="@mode">@mode</option>
                }
            </select>
            <button class="run-button" type="button" @onclick="RunMissionAsync" disabled="@(!CanRunMission)">
                <span class="play-symbol" aria-hidden="true">@PlaySymbolSvg</span>
                <span>RUN MISSION</span>
            </button>
            <button class="abort-button" type="button" @onclick="AbortMissionAsync" disabled="@(!isRunning && !isConnected)">ABORT MISSION</button>
        </div>
    </header>

    <section class="route-panel">
        <div class="manager-card">
            <div class="manager-heading">
                <strong>Mission</strong>
                <span>@missionBlocks.Count block@(missionBlocks.Count == 1 ? "" : "s") / @routePoints.Count point@(routePoints.Count == 1 ? "" : "s")</span>
            </div>
            <div class="manager-grid mission-grid">
                <label class="route-field">
                    <span>Name</span>
                    <input type="text" @bind="procedureName" maxlength="45" disabled="@(isRunning || isRouteBusy)" />
                </label>
                <label class="route-field">
                    <span>Saved</span>
                    <div class="route-select-row">
                        <select value="@selectedProcedureId" @onchange="SelectProcedureAsync" disabled="@(isRunning || isRouteBusy)">
                            <option value="">Select mission</option>
                            @foreach (var procedure in savedProcedures)
                            {
                                <option value="@procedure.SequenceId">@procedure.Name</option>
                            }
                        </select>
                        <button class="delete-route-button" type="button" title="Delete mission" aria-label="Delete selected mission" @onclick="DeleteSelectedProcedureAsync" disabled="@(isRunning || isRouteBusy || string.IsNullOrWhiteSpace(selectedProcedureId))">x</button>
                    </div>
                </label>
                <button class="route-button primary" type="button" @onclick="SaveProcedureAsync" disabled="@(isRunning || isRouteBusy || missionBlocks.Count == 0)">SAVE MISSION</button>
            </div>
        </div>
    </section>

    <main class="forge-workbench">
        <aside class="block-palette">
            @RenderPaletteSection("Movement", movementTemplates)
            @RenderPaletteSection("Navigation", navigationTemplates)
            @RenderPaletteSection("Logic", logicTemplates)
            @RenderPaletteSection("Safety", safetyTemplates)
        </aside>

        <section class="mission-canvas">
            <div class="chain">
                <div class="start-block block-shell">
                    @StartBlockSvg
                    <div class="block-line start-line">
                        <span>Start of chain</span>
                    </div>
                </div>

                <SortableList TItem="MissionBlock"
                              Items="missionBlocks"
                              ItemKey="BlockKey"
                              ContainerClass="mission-sortable-list"
                              ItemClass="mission-sortable-item"
                              PlaceholderClass="mission-sortable-placeholder"
                              Disabled="@isRunning"
                              OnMove="MoveMissionBlock"
                              OnExternalDrop="AddBlockFromPalette">
                    <EmptyContent>
                        <div class="insert-slot empty">Drop first block here</div>
                    </EmptyContent>
                    <ItemTemplate Context="block">
                        <article class="mission-block block-shell @(IsEndBlock(block.Kind) ? "end-block" : "") @(runningBlockId == block.Id ? "running" : "")">
                            @BlockShapeSvg(block.Kind)
                            <div class="block-line drag-handle">
                                @RenderBlockEditor(block)
                                <button class="remove-block" type="button" title="Remove block" @onclick="() => RemoveBlock(block.Id)" disabled="@isRunning">x</button>
                            </div>
                        </article>
                    </ItemTemplate>
                </SortableList>
            </div>
        </section>
    </main>

    <footer class="forge-status">
        <div>
            <span class="status-pill @(isConnected ? "online" : "offline")"></span>
            @status
        </div>
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <pre>@error</pre>
        }
    </footer>

    <aside class="gps-map-card" @ref="gpsMapCardReference" aria-label="Route satellite map">
        <button class="gps-map-resize-handle"
                @ref="gpsMapResizeHandleReference"
                type="button"
                title="Resize map"
                aria-label="Resize map">
            <span></span>
        </button>

        <div class="gps-map-title">
            <span>Route Map</span>
            <div class="gps-map-actions">
                <strong>Click map to add point</strong>
                <button class="map-action-button" type="button" @onclick="CenterMapOnDroneAsync" disabled="@(telemetry.Latitude is null || telemetry.Longitude is null)">CURRENT DRONE</button>
            </div>
        </div>

        <div class="gps-map-frame">
            <div class="gps-map" @ref="routeMapReference"></div>
        </div>

        <div class="gps-map-readout">
            <span><b>LAT</b>@LatitudeLabel</span>
            <span><b>LON</b>@LongitudeLabel</span>
            <span><b>POINTS</b>@routePoints.Count</span>
        </div>
    </aside>
</div>

@code {
    private readonly CancellationTokenSource telemetryCancellation = new();
    private CancellationTokenSource? missionCancellation;
    private readonly List<MissionBlock> missionBlocks = new();
    private readonly List<MapTrailPoint> gpsTrail = new();
    private MapTrailPoint? latestMapPoint;
    private double? mapOriginLatitude;
    private double? mapOriginLongitude;
    private double? mapOriginLocalX;
    private double? mapOriginLocalY;
    private ElementReference gpsMapCardReference;
    private ElementReference gpsMapResizeHandleReference;
    private ElementReference routeMapReference;
    private DotNetObjectReference<Procedure>? procedureReference;
    private IJSObjectReference? procedureMapModule;
    private double gpsMapWidth = 440.0;
    private double gpsMapHeight = 360.0;
    private bool hasInitializedGpsMapResize;
    private bool hasInitializedRouteMap;
    private double? missionGroundAltitude;
    private double? currentLegTargetAltitude;
    private const double MapWidth = 240.0;
    private const double MapHeight = 160.0;
    private const double MapPadding = 20.0;

    private readonly BlockTemplate[] movementTemplates =
    [
        new(BlockKind.Arm, "Arm motors"),
        new(BlockKind.Takeoff, "Takeoff to ...m"),
        new(BlockKind.Fly, "Fly ... at ...m/s for ...s"),
        new(BlockKind.Turn, "Turn ..."),
        new(BlockKind.ChangeAltitude, "Change altitude to ...m"),
        new(BlockKind.Hover, "Hold for ...s"),
        new(BlockKind.Land, "Land on ground"),
        new(BlockKind.Disarm, "Dearm motors"),
    ];

    private readonly BlockTemplate[] navigationTemplates =
    [
        new(BlockKind.GotoGps, "Fly GPS ..."),
        new(BlockKind.GotoLocal, "Fly local ..."),
        new(BlockKind.ReturnHome, "Return home"),
    ];

    private readonly BlockTemplate[] logicTemplates =
    [
        new(BlockKind.Wait, "Wait for ... seconds"),
        new(BlockKind.WaitUntilAltitude, "Wait altitude ...m"),
        new(BlockKind.WaitUntilGpsFix, "Wait GPS fix"),
        new(BlockKind.RepeatNext, "Repeat ... times"),
        new(BlockKind.IfBatteryBelow, "If battery < ...%"),
    ];

    private readonly BlockTemplate[] safetyTemplates =
    [
        new(BlockKind.FailsafeReturn, "Failsafe: Return"),
        new(BlockKind.FailsafeLand, "Failsafe: Land"),
    ];

    private string status = "Ready";
    private string error = "";
    private string selectedMode = "STABILIZE";
    private string routeName = "New route";
    private string selectedRouteId = "";
    private string procedureName = "New procedure";
    private string selectedProcedureId = "";
    private Guid? runningBlockId;
    private TelemetrySnapshot telemetry = new();
    private List<DroneApiService.RouteSummary> savedRoutes = [];
    private List<DroneApiService.SequenceSummary> savedProcedures = [];
    private readonly List<RoutePointDraft> routePoints = [];
    private int selectedRoutePointCount;
    private double newPointLatitude = 47.397742;
    private double newPointLongitude = 8.545594;
    private double newPointAltitude = 5.0;
    private bool isRunning;
    private bool isConnected;
    private bool isConnecting;
    private bool isChangingMode;
    private bool isRouteBusy;

    private readonly string[] selectableModes =
    [
        "STABILIZE",
        "ALT_HOLD",
        "GUIDED",
        "LOITER",
        "AUTO",
        "RTL",
        "LAND",
    ];

    private string AltitudeLabel => FormattableString.Invariant($"{telemetry.AltitudeMeters:0.0}m");
    private string LatitudeLabel => telemetry.Latitude is null ? "--" : FormattableString.Invariant($"{telemetry.Latitude.Value:0.0000000}");
    private string LongitudeLabel => telemetry.Longitude is null ? "--" : FormattableString.Invariant($"{telemetry.Longitude.Value:0.0000000}");
    private string GpsFixLabel => telemetry.GpsFixType <= 0 ? $"NO FIX / {telemetry.SatellitesVisible} SAT" : $"{telemetry.GpsFixType} / {telemetry.SatellitesVisible} SAT";
    private string ModeLabel => string.IsNullOrWhiteSpace(telemetry.Mode) ? "UNKNOWN" : telemetry.Mode;
    private string ArmLabel => telemetry.Armed ? "ARMED" : "UNARMED";
    private string ConnectButtonLabel => isConnecting ? "CONNECTING" : isConnected ? "DISCONNECT" : "CONNECT";
    private bool CanRunMission => isConnected && !isRunning && missionBlocks.Count > 0;
    private bool CanSaveRoute => !string.IsNullOrWhiteSpace(routeName) && routePoints.Count > 0;
    private bool CanRunSelectedRoute => isConnected && !isRunning && !isRouteBusy && !string.IsNullOrWhiteSpace(selectedRouteId);
    private string SelectedRoutePointLabel => selectedRoutePointCount <= 0 ? "No points loaded" : $"{selectedRoutePointCount} point{(selectedRoutePointCount == 1 ? "" : "s")}";
    private bool HasMapPosition => latestMapPoint is not null;
    private string MapPathPoints => gpsTrail.Count < 2 ? string.Empty : string.Join(" ", gpsTrail.Select(point => FormatSvgPoint(ProjectMapPoint(point))));
    private string MapHomeX => gpsTrail.Count == 0 ? SvgNumber(MapWidth / 2.0) : SvgNumber(ProjectMapPoint(gpsTrail[0]).X);
    private string MapHomeY => gpsTrail.Count == 0 ? SvgNumber(MapHeight / 2.0) : SvgNumber(ProjectMapPoint(gpsTrail[0]).Y);
    private string DroneMapX => latestMapPoint is null ? SvgNumber(MapWidth / 2.0) : SvgNumber(ProjectMapPoint(latestMapPoint).X);
    private string DroneMapY => latestMapPoint is null ? SvgNumber(MapHeight / 2.0) : SvgNumber(ProjectMapPoint(latestMapPoint).Y);
    private string DroneHeadingX => SvgNumber(ProjectHeadingEnd().X);
    private string DroneHeadingY => SvgNumber(ProjectHeadingEnd().Y);
    private string MapRangeLabel => HasMapPosition ? FormattableString.Invariant($"{GetMapVisibleSpanMeters():0.#}m") : "--";

    protected override void OnInitialized()
    {
        _ = PollTelemetryAsync(telemetryCancellation.Token);
        _ = LoadRoutesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        procedureReference ??= DotNetObjectReference.Create(this);
        procedureMapModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "/js/procedureMap.js?v=20260614-1");

        if (!hasInitializedGpsMapResize)
        {
            await procedureMapModule.InvokeVoidAsync(
                "initializeResize",
                gpsMapCardReference,
                gpsMapResizeHandleReference,
                procedureReference,
                new
                {
                    initialWidth = gpsMapWidth,
                    initialHeight = gpsMapHeight,
                    minWidth = 320.0,
                    minHeight = 260.0,
                    maxWidth = 980.0,
                    maxHeight = 760.0,
                });
            hasInitializedGpsMapResize = true;
        }

        if (!hasInitializedRouteMap)
        {
            await procedureMapModule.InvokeVoidAsync(
                "initializeRouteMap",
                routeMapReference,
                procedureReference,
                new
                {
                    latitude = telemetry.Latitude ?? newPointLatitude,
                    longitude = telemetry.Longitude ?? newPointLongitude,
                    zoom = 17,
                });
            hasInitializedRouteMap = true;
        }

        await UpdateRouteMapAsync(fitRoute: firstRender);
    }

    private RenderFragment RenderPaletteSection(string title, IReadOnlyList<BlockTemplate> templates) => @<section class="palette-section">
        <h2>@title</h2>
        @foreach (var template in templates)
        {
            <div class="palette-block block-shell" role="button" tabindex="0" data-sortable-template-kind="@template.Kind" aria-label="@template.Label">
                @NormalBlockSvg
                <span>@template.Label</span>
            </div>
        }
    </section>;

    private static string BlockKey(MissionBlock block)
    {
        return block.Id.ToString("N");
    }

    private void AddBlockFromPalette(SortableListExternalDropEventArgs args)
    {
        if (isRunning)
        {
            return;
        }

        if (!Enum.TryParse<BlockKind>(args.Payload, out var kind))
        {
            return;
        }

        missionBlocks.Insert(Math.Clamp(args.NewIndex, 0, missionBlocks.Count), CreateBlock(kind));
        SyncRoutePointsFromMissionBlocks();
        _ = UpdateRouteMapAsync(fitRoute: true);
    }

    private void MoveMissionBlock(SortableListMoveEventArgs args)
    {
        if (isRunning)
        {
            return;
        }

        var currentIndex = missionBlocks.FindIndex(block => BlockKey(block) == args.ItemId);
        if (currentIndex < 0)
        {
            return;
        }

        var movedBlock = missionBlocks[currentIndex];
        missionBlocks.RemoveAt(currentIndex);
        var targetIndex = Math.Clamp(args.NewIndex, 0, missionBlocks.Count);

        if (currentIndex == targetIndex)
        {
            missionBlocks.Insert(currentIndex, movedBlock);
            return;
        }

        missionBlocks.Insert(targetIndex, movedBlock);
    }

    private static MissionBlock CreateBlock(BlockKind kind)
    {
        return kind switch
        {
            BlockKind.Takeoff => new MissionBlock(kind) { Altitude = 5.0, TimeoutSeconds = 45.0 },
            BlockKind.Fly => new MissionBlock(kind) { Direction = FlightDirection.Forward, Speed = 0.5, Seconds = 2.0 },
            BlockKind.Turn => new MissionBlock(kind) { Degrees = 90.0, Speed = 35.0, Tolerance = 8.0, TimeoutSeconds = 20.0 },
            BlockKind.ChangeAltitude => new MissionBlock(kind) { Altitude = 5.0, Speed = 0.4, Tolerance = 0.25, TimeoutSeconds = 30.0 },
            BlockKind.Hover => new MissionBlock(kind) { Seconds = 3.0 },
            BlockKind.GotoGps => new MissionBlock(kind) { Latitude = 47.397742, Longitude = 8.545594, Altitude = 5.0, Radius = 2.0, TimeoutSeconds = 90.0 },
            BlockKind.GotoLocal => new MissionBlock(kind) { LocalX = 5.0, LocalY = 0.0, Altitude = 5.0, Radius = 0.75, TimeoutSeconds = 45.0 },
            BlockKind.Wait => new MissionBlock(kind) { Seconds = 1.0 },
            BlockKind.WaitUntilAltitude => new MissionBlock(kind) { Altitude = 5.0, Tolerance = 0.25, TimeoutSeconds = 45.0 },
            BlockKind.WaitUntilGpsFix => new MissionBlock(kind) { Count = 6, TimeoutSeconds = 30.0 },
            BlockKind.RepeatNext => new MissionBlock(kind) { Count = 2 },
            BlockKind.IfBatteryBelow => new MissionBlock(kind) { Percent = 25 },
            _ => new MissionBlock(kind),
        };
    }

    private void RemoveBlock(Guid id)
    {
        if (isRunning)
        {
            return;
        }

        missionBlocks.RemoveAll(block => block.Id == id);
        SyncRoutePointsFromMissionBlocks();
        _ = UpdateRouteMapAsync(fitRoute: true);
    }

    private async Task LoadRoutesAsync()
    {
        isRouteBusy = true;
        error = "";

        try
        {
            var sequenceResult = await Drone.GetSequences();
            if (!sequenceResult.Success)
            {
                throw new InvalidOperationException(CombineError(sequenceResult.ErrorMessage, sequenceResult.ResponseBody));
            }

            savedProcedures = sequenceResult.Data ?? [];
            status = savedProcedures.Count == 0 ? "No saved missions" : $"Loaded {savedProcedures.Count} mission{(savedProcedures.Count == 1 ? "" : "s")}";
        }
        catch (Exception exception)
        {
            status = "Mission list failed";
            error = exception.Message;
        }
        finally
        {
            isRouteBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveRouteAsync()
    {
        if (!CanSaveRoute)
        {
            return;
        }

        isRouteBusy = true;
        error = "";

        try
        {
            var points = BuildRoutePoints();
            var name = routeName.Trim();
            var overwrite = false;
            if (RouteNameExists(name))
            {
                overwrite = await Js.InvokeAsync<bool>("confirm", $"Route '{name}' already exists. Override?");
                if (!overwrite)
                {
                    status = "Save route cancelled";
                    return;
                }
            }

            var result = await Drone.CreateRoute(name, points, overwrite: overwrite);
            if (!result.Success || result.Data is null)
            {
                throw new InvalidOperationException(CombineError(result.ErrorMessage, result.ResponseBody));
            }

            selectedRouteId = result.Data.RouteId;
            selectedRoutePointCount = result.Data.Points.Count;
            await LoadRoutesAsync();
            selectedRouteId = result.Data.RouteId;
            selectedRoutePointCount = result.Data.Points.Count;
            status = $"Route saved: {result.Data.Name}";
        }
        catch (Exception exception)
        {
            status = "Save route failed";
            error = exception.Message;
        }
        finally
        {
            isRouteBusy = false;
        }
    }

    private async Task SaveProcedureAsync()
    {
        if (missionBlocks.Count == 0)
        {
            return;
        }

        isRouteBusy = true;
        error = "";

        try
        {
            var name = string.IsNullOrWhiteSpace(procedureName) ? $"Procedure {DateTime.Now:HHmmss}" : procedureName.Trim();
            var overwrite = false;
            if (ProcedureNameExists(name))
            {
                overwrite = await Js.InvokeAsync<bool>("confirm", $"Procedure '{name}' already exists. Override?");
                if (!overwrite)
                {
                    status = "Save procedure cancelled";
                    return;
                }
            }

            var result = await Drone.CreateSequence(name, BuildProcedureCommands(), overwrite);
            if (!result.Success)
            {
                throw new InvalidOperationException(CombineError(result.ErrorMessage, result.ResponseBody));
            }

            status = $"Mission saved: {name}";
            await LoadRoutesAsync();
        }
        catch (Exception exception)
        {
            status = "Save mission failed";
            error = exception.Message;
        }
        finally
        {
            isRouteBusy = false;
        }
    }

    private async Task SelectRouteAsync(ChangeEventArgs args)
    {
        selectedRouteId = args.Value?.ToString() ?? "";
        selectedRoutePointCount = 0;

        if (!string.IsNullOrWhiteSpace(selectedRouteId))
        {
            await LoadSelectedRouteAsync();
        }
    }

    private async Task DeleteSelectedRouteAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedRouteId) || isRunning || isRouteBusy)
        {
            return;
        }

        var routeId = selectedRouteId;
        var routeLabel = savedRoutes.FirstOrDefault(route => route.RouteId == routeId)?.Name ?? routeName;
        var confirmed = await Js.InvokeAsync<bool>("confirm", $"Route '{routeLabel}' delete?");
        if (!confirmed)
        {
            status = "Delete route cancelled";
            return;
        }

        isRouteBusy = true;
        error = "";

        try
        {
            var result = await Drone.DeleteRoute(routeId);
            if (!result.Success)
            {
                throw new InvalidOperationException(CombineError(result.ErrorMessage, result.ResponseBody));
            }

            selectedRouteId = "";
            routeName = "New route";
            routePoints.Clear();
            selectedRoutePointCount = 0;
            RebuildProcedureFromRoutePoints();
            await LoadRoutesAsync();
            status = $"Route deleted: {routeLabel}";
            await UpdateRouteMapAsync(fitRoute: true);
        }
        catch (Exception exception)
        {
            status = "Delete route failed";
            error = exception.Message;
        }
        finally
        {
            isRouteBusy = false;
        }
    }

    private async Task SelectProcedureAsync(ChangeEventArgs args)
    {
        selectedProcedureId = args.Value?.ToString() ?? "";

        if (!string.IsNullOrWhiteSpace(selectedProcedureId))
        {
            await LoadSelectedProcedureAsync();
        }
    }

    private async Task DeleteSelectedProcedureAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedProcedureId) || isRunning || isRouteBusy)
        {
            return;
        }

        var sequenceId = selectedProcedureId;
        var missionLabel = savedProcedures.FirstOrDefault(sequence => sequence.SequenceId == sequenceId)?.Name ?? procedureName;
        var confirmed = await Js.InvokeAsync<bool>("confirm", $"Mission '{missionLabel}' delete?");
        if (!confirmed)
        {
            status = "Delete mission cancelled";
            return;
        }

        isRouteBusy = true;
        error = "";

        try
        {
            var result = await Drone.DeleteSequence(sequenceId);
            if (!result.Success)
            {
                throw new InvalidOperationException(CombineError(result.ErrorMessage, result.ResponseBody));
            }

            selectedProcedureId = "";
            procedureName = "New procedure";
            missionBlocks.Clear();
            routePoints.Clear();
            selectedRoutePointCount = 0;
            await LoadRoutesAsync();
            await UpdateRouteMapAsync(fitRoute: true);
            status = $"Mission deleted: {missionLabel}";
        }
        catch (Exception exception)
        {
            status = "Delete mission failed";
            error = exception.Message;
        }
        finally
        {
            isRouteBusy = false;
        }
    }

    private async Task LoadSelectedProcedureAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedProcedureId))
        {
            return;
        }

        isRouteBusy = true;
        error = "";

        try
        {
            var result = await Drone.GetSequence(selectedProcedureId);
            if (!result.Success || result.Data is null)
            {
                throw new InvalidOperationException(CombineError(result.ErrorMessage, result.ResponseBody));
            }

            missionBlocks.Clear();
            foreach (var command in result.Data.Commands.OrderBy(command => command.OrderIndex))
            {
                missionBlocks.Add(CreateBlockFromStoredCommand(command));
            }

            procedureName = result.Data.Name;
            SyncRoutePointsFromMissionBlocks();
            await UpdateRouteMapAsync(fitRoute: true);
            status = $"Mission loaded: {result.Data.Name}";
        }
        catch (Exception exception)
        {
            status = "Load mission failed";
            error = exception.Message;
        }
        finally
        {
            isRouteBusy = false;
        }
    }

    private async Task LoadSelectedRouteAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedRouteId))
        {
            return;
        }

        isRouteBusy = true;
        error = "";

        try
        {
            var result = await Drone.GetRoute(selectedRouteId);
            if (!result.Success || result.Data is null)
            {
                throw new InvalidOperationException(CombineError(result.ErrorMessage, result.ResponseBody));
            }

            ApplyRouteToEditor(result.Data);
            routeName = result.Data.Name;
            selectedRoutePointCount = result.Data.Points.Count;
            status = $"Route loaded: {result.Data.Name}";
            await UpdateRouteMapAsync(fitRoute: true);
        }
        catch (Exception exception)
        {
            status = "Load route failed";
            error = exception.Message;
        }
        finally
        {
            isRouteBusy = false;
        }
    }

    private async Task RunSelectedRouteGuidedAsync()
    {
        if (!CanRunSelectedRoute)
        {
            return;
        }

        isRunning = true;
        isRouteBusy = true;
        error = "";
        status = "Guided route running";

        try
        {
            var result = await Drone.ExecuteGuidedRoute(selectedRouteId);
            if (!result.Success)
            {
                throw new InvalidOperationException(CombineError(result.ErrorMessage, result.ResponseBody));
            }

            status = "Guided route sent";
            await RefreshTelemetryAsync();
        }
        catch (Exception exception)
        {
            status = "Guided route failed";
            error = exception.Message;
        }
        finally
        {
            isRunning = false;
            isRouteBusy = false;
        }
    }

    private List<DroneApiService.RoutePointRequest> BuildRoutePoints()
    {
        return routePoints
            .Select((point, index) => new DroneApiService.RoutePointRequest
            {
                Latitude = point.Latitude,
                Longitude = point.Longitude,
                AltitudeMeters = point.AltitudeMeters,
                OrderIndex = index,
            })
            .ToList();
    }

    private bool RouteNameExists(string name)
    {
        return savedRoutes.Any(route => string.Equals(route.Name, name, StringComparison.OrdinalIgnoreCase));
    }

    private bool ProcedureNameExists(string name)
    {
        return savedProcedures.Any(sequence => string.Equals(sequence.Name, name, StringComparison.OrdinalIgnoreCase));
    }

    private void AddRoutePointFromInputs()
    {
        routePoints.Add(new RoutePointDraft
        {
            Latitude = newPointLatitude,
            Longitude = newPointLongitude,
            AltitudeMeters = newPointAltitude,
        });
        selectedRoutePointCount = routePoints.Count;
        RebuildProcedureFromRoutePoints();
        _ = UpdateRouteMapAsync(fitRoute: true);
    }

    private void RemoveRoutePoint(int index)
    {
        if (index < 0 || index >= routePoints.Count)
        {
            return;
        }

        routePoints.RemoveAt(index);
        selectedRoutePointCount = routePoints.Count;
        RebuildProcedureFromRoutePoints();
        _ = UpdateRouteMapAsync(fitRoute: true);
    }

    private void RebuildProcedureFromRoutePoints()
    {
        missionBlocks.Clear();

        foreach (var point in routePoints)
        {
            var arm = CreateBlock(BlockKind.Arm);
            missionBlocks.Add(arm);

            var takeoff = CreateBlock(BlockKind.Takeoff);
            takeoff.Altitude = Math.Max(1.0, point.AltitudeMeters);
            takeoff.TimeoutSeconds = 45.0;
            missionBlocks.Add(takeoff);

            var flyToPoint = CreateBlock(BlockKind.GotoGps);
            flyToPoint.Latitude = point.Latitude;
            flyToPoint.Longitude = point.Longitude;
            flyToPoint.Altitude = Math.Max(1.0, point.AltitudeMeters);
            flyToPoint.Radius = 2.0;
            flyToPoint.TimeoutSeconds = 90.0;
            missionBlocks.Add(flyToPoint);

            var land = CreateBlock(BlockKind.Land);
            land.TimeoutSeconds = 45.0;
            missionBlocks.Add(land);
        }

        if (routePoints.Count > 0 && string.IsNullOrWhiteSpace(procedureName))
        {
            procedureName = $"{routeName.Trim()} procedure";
        }
    }

    private void SyncRoutePointsFromMissionBlocks()
    {
        routePoints.Clear();

        foreach (var block in missionBlocks.Where(block => block.Kind == BlockKind.GotoGps))
        {
            routePoints.Add(new RoutePointDraft
            {
                Latitude = block.Latitude,
                Longitude = block.Longitude,
                AltitudeMeters = Math.Max(1.0, block.Altitude),
            });
        }

        selectedRoutePointCount = routePoints.Count;
    }

    private List<DroneApiService.StoredCommandRequest> BuildProcedureCommands()
    {
        return missionBlocks
            .Select((block, index) => new DroneApiService.StoredCommandRequest
            {
                Command = block.Kind.ToString(),
                OrderIndex = index,
                Parameters = BuildProcedureParameters(block),
            })
            .ToList();
    }

    private static MissionBlock CreateBlockFromStoredCommand(DroneApiService.StoredCommand command)
    {
        if (!Enum.TryParse<BlockKind>(command.Command, out var kind))
        {
            kind = BlockKind.Wait;
        }

        var block = CreateBlock(kind);
        block.Altitude = ParameterDouble(command.Parameters, "altitude_meters", block.Altitude);
        block.Speed = ParameterDouble(command.Parameters, "speed", block.Speed);
        block.Seconds = ParameterDouble(command.Parameters, "seconds", block.Seconds);
        block.Degrees = ParameterDouble(command.Parameters, "degrees", block.Degrees);
        block.Latitude = ParameterDouble(command.Parameters, "latitude", block.Latitude);
        block.Longitude = ParameterDouble(command.Parameters, "longitude", block.Longitude);
        block.LocalX = ParameterDouble(command.Parameters, "local_x", block.LocalX);
        block.LocalY = ParameterDouble(command.Parameters, "local_y", block.LocalY);
        block.Radius = ParameterDouble(command.Parameters, "radius", block.Radius);
        block.Tolerance = ParameterDouble(command.Parameters, "tolerance", block.Tolerance);
        block.TimeoutSeconds = ParameterDouble(command.Parameters, "timeout_seconds", block.TimeoutSeconds);
        block.Count = ParameterInt(command.Parameters, "count", block.Count);
        block.Percent = ParameterInt(command.Parameters, "percent", block.Percent);

        var direction = ParameterString(command.Parameters, "direction", block.Direction.ToString());
        if (Enum.TryParse<FlightDirection>(direction, out var parsedDirection))
        {
            block.Direction = parsedDirection;
        }

        return block;
    }

    private static double ParameterDouble(Dictionary<string, object?> parameters, string key, double fallback)
    {
        if (!parameters.TryGetValue(key, out var value) || value is null)
        {
            return fallback;
        }

        return value switch
        {
            double number => number,
            float number => number,
            int number => number,
            long number => number,
            decimal number => (double)number,
            JsonElement element when element.ValueKind == JsonValueKind.Number && element.TryGetDouble(out var number) => number,
            JsonElement element when element.ValueKind == JsonValueKind.String && double.TryParse(element.GetString(), out var number) => number,
            string text when double.TryParse(text, out var number) => number,
            _ => fallback,
        };
    }

    private static int ParameterInt(Dictionary<string, object?> parameters, string key, int fallback)
    {
        return (int)Math.Round(ParameterDouble(parameters, key, fallback));
    }

    private static string ParameterString(Dictionary<string, object?> parameters, string key, string fallback)
    {
        if (!parameters.TryGetValue(key, out var value) || value is null)
        {
            return fallback;
        }

        return value switch
        {
            JsonElement element when element.ValueKind == JsonValueKind.String => element.GetString() ?? fallback,
            string text => text,
            _ => value.ToString() ?? fallback,
        };
    }

    private static Dictionary<string, object?> BuildProcedureParameters(MissionBlock block)
    {
        return new Dictionary<string, object?>
        {
            ["altitude_meters"] = block.Altitude,
            ["speed"] = block.Speed,
            ["seconds"] = block.Seconds,
            ["degrees"] = block.Degrees,
            ["latitude"] = block.Latitude,
            ["longitude"] = block.Longitude,
            ["local_x"] = block.LocalX,
            ["local_y"] = block.LocalY,
            ["radius"] = block.Radius,
            ["tolerance"] = block.Tolerance,
            ["timeout_seconds"] = block.TimeoutSeconds,
            ["count"] = block.Count,
            ["percent"] = block.Percent,
            ["direction"] = block.Direction.ToString(),
        };
    }

    private void ApplyRouteToEditor(DroneApiService.RouteDetail route)
    {
        routePoints.Clear();

        foreach (var point in route.Points.OrderBy(point => point.OrderIndex))
        {
            routePoints.Add(new RoutePointDraft
            {
                Latitude = point.Latitude,
                Longitude = point.Longitude,
                AltitudeMeters = point.AltitudeMeters,
            });
        }

        RebuildProcedureFromRoutePoints();
    }

    private async Task ToggleConnectionAsync()
    {
        if (isConnecting || isRunning)
        {
            return;
        }

        error = "";
        isConnecting = true;

        try
        {
            if (isConnected)
            {
                await EnsureSuccess("Disconnect", Drone.Disconnect());
                isConnected = false;
                status = "Disconnected";
                return;
            }

            status = "Connecting";
            await EnsureSuccess("Connect", Drone.Connect());
            await RefreshTelemetryAsync();
            status = isConnected ? "Connected" : "Connect sent";
        }
        catch (Exception exception)
        {
            status = isConnected ? "Disconnect failed" : "Connect failed";
            error = exception.Message;
        }
        finally
        {
            isConnecting = false;
        }
    }

    private async Task ChangeModeAsync(ChangeEventArgs args)
    {
        var newMode = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(newMode))
        {
            return;
        }

        selectedMode = newMode;
        if (!isConnected || isRunning || isChangingMode)
        {
            return;
        }

        error = "";
        isChangingMode = true;

        try
        {
            await EnsureSuccess($"Set mode {newMode}", Drone.SetMode(newMode));
            status = $"Mode set: {newMode}";
            await RefreshTelemetryAsync();
        }
        catch (Exception exception)
        {
            status = "Mode change failed";
            error = exception.Message;
        }
        finally
        {
            isChangingMode = false;
        }
    }

    private async Task RunMissionAsync()
    {
        if (!CanRunMission)
        {
            return;
        }

        error = "";
        status = "Mission running";
        isRunning = true;
        missionCancellation = new CancellationTokenSource();
        var token = missionCancellation.Token;

        try
        {
            for (var index = 0; index < missionBlocks.Count; index++)
            {
                token.ThrowIfCancellationRequested();
                var block = missionBlocks[index];

                if (block.Kind == BlockKind.RepeatNext)
                {
                    if (index + 1 >= missionBlocks.Count)
                    {
                        continue;
                    }

                    var nextBlock = missionBlocks[index + 1];
                    for (var repeat = 0; repeat < Math.Max(1, block.Count); repeat++)
                    {
                        token.ThrowIfCancellationRequested();
                        await ExecuteBlockAsync(nextBlock, token);
                    }

                    index++;
                    continue;
                }

                await ExecuteBlockAsync(block, token);
            }

            runningBlockId = null;
            status = "Mission finished";
        }
        catch (OperationCanceledException)
        {
            runningBlockId = null;
            status = "Mission aborted";
        }
        catch (Exception exception)
        {
            runningBlockId = null;
            status = "Mission failed";
            error = exception.Message;
        }
        finally
        {
            isRunning = false;
            missionCancellation?.Dispose();
            missionCancellation = null;
            await RefreshTelemetryAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ExecuteBlockAsync(MissionBlock block, CancellationToken token)
    {
        runningBlockId = block.Id;
        status = $"Running: {BlockTitle(block)}";
        await InvokeAsync(StateHasChanged);

        switch (block.Kind)
        {
            case BlockKind.Arm:
                await EnsureSuccess("Set mode GUIDED", Drone.SetMode("GUIDED"));
                await WaitUntilModeAsync("GUIDED", TimeSpan.FromSeconds(8), token);
                await EnsureSuccess("Arm motors", Drone.Arm());
                await WaitUntilAsync("armed", () => telemetry.Armed, TimeSpan.FromSeconds(10), token);
                break;
            case BlockKind.Takeoff:
                await RefreshTelemetryAsync();
                missionGroundAltitude = telemetry.AltitudeMeters;
                currentLegTargetAltitude = missionGroundAltitude.Value + Math.Max(1.0, block.Altitude);
                await EnsureSuccess("Takeoff", Drone.Takeoff(currentLegTargetAltitude.Value, armFirst: true));
                await WaitUntilAltitudeAsync(currentLegTargetAltitude.Value, block.ToleranceOrDefault(0.25), TimeSpan.FromSeconds(block.TimeoutSecondsOrDefault(45)), token);
                break;
            case BlockKind.Fly:
                var (vx, vy, vz) = VelocityFor(block.Direction, block.Speed);
                await EnsureSuccess("Fly", Drone.SendVelocity(vx, vy, vz, block.Seconds));
                break;
            case BlockKind.Turn:
                await TurnAndWaitAsync(block, token);
                break;
            case BlockKind.ChangeAltitude:
                await ChangeAltitudeAsync(block, token);
                break;
            case BlockKind.Hover:
                await EnsureSuccess("Hold position", Drone.SendVelocity(0, 0, 0, 0.1));
                await DelayWithTelemetryAsync(TimeSpan.FromSeconds(Math.Max(0, block.Seconds)), token);
                break;
            case BlockKind.GotoGps:
                var gpsTargetAltitude = currentLegTargetAltitude ?? ((missionGroundAltitude ?? telemetry.AltitudeMeters) + Math.Max(1.0, block.Altitude));
                await EnsureSuccess("Go to GPS", Drone.GotoGlobal(block.Latitude, block.Longitude, gpsTargetAltitude));
                await WaitUntilGpsTargetAsync(block, gpsTargetAltitude, token);
                break;
            case BlockKind.GotoLocal:
                await EnsureSuccess("Go to local position", Drone.GotoLocal(block.LocalX, block.LocalY, -Math.Abs(block.Altitude)));
                await WaitUntilLocalTargetAsync(block, token);
                break;
            case BlockKind.ReturnHome:
                await EnsureSuccess("Return home", Drone.Rtl());
                await WaitUntilModeAsync("RTL", TimeSpan.FromSeconds(8), token);
                break;
            case BlockKind.Land:
                await EnsureSuccess("Land", Drone.Land());
                await WaitUntilLandedReadyAsync(token);
                currentLegTargetAltitude = null;
                break;
            case BlockKind.Disarm:
                await EnsureSuccess("Disarm", Drone.Disarm());
                await WaitUntilAsync("disarmed", () => !telemetry.Armed, TimeSpan.FromSeconds(10), token);
                break;
            case BlockKind.Wait:
                await DelayWithTelemetryAsync(TimeSpan.FromSeconds(Math.Max(0, block.Seconds)), token);
                break;
            case BlockKind.WaitUntilAltitude:
                await WaitUntilAltitudeAsync(block.Altitude, block.ToleranceOrDefault(0.25), TimeSpan.FromSeconds(block.TimeoutSecondsOrDefault(45)), token);
                break;
            case BlockKind.WaitUntilGpsFix:
                await WaitUntilAsync(
                    "GPS fix",
                    () => telemetry.GpsFixType >= 3 && telemetry.SatellitesVisible >= Math.Max(1, block.Count),
                    TimeSpan.FromSeconds(block.TimeoutSecondsOrDefault(30)),
                    token);
                break;
            case BlockKind.IfBatteryBelow:
                await RefreshTelemetryAsync();
                if (telemetry.BatteryPercent < block.Percent)
                {
                    await EnsureSuccess("Battery failsafe return", Drone.Rtl());
                    throw new OperationCanceledException(token);
                }
                break;
            case BlockKind.FailsafeReturn:
                await EnsureSuccess("Failsafe return", Drone.Rtl());
                throw new OperationCanceledException(token);
            case BlockKind.FailsafeLand:
                await AbortMissionAsync();
                throw new OperationCanceledException(token);
        }

        await RefreshTelemetryAsync();
    }

    private async Task TurnAndWaitAsync(MissionBlock block, CancellationToken token)
    {
        await RefreshTelemetryAsync();
        var startHeading = telemetry.HeadingDegrees;
        await EnsureSuccess("Turn", Drone.Yaw(block.Degrees, block.Speed, isRelative: true));

        if (startHeading is null)
        {
            var fallbackSeconds = Math.Clamp(Math.Abs(block.Degrees) / Math.Max(1.0, block.Speed), 0.4, block.TimeoutSecondsOrDefault(20));
            await DelayWithTelemetryAsync(TimeSpan.FromSeconds(fallbackSeconds), token);
            return;
        }

        var targetHeading = NormalizeHeading(startHeading.Value + block.Degrees);
        await WaitUntilAsync(
            "target heading",
            () => telemetry.HeadingDegrees is not null && HeadingDelta(telemetry.HeadingDegrees.Value, targetHeading) <= block.ToleranceOrDefault(8.0),
            TimeSpan.FromSeconds(block.TimeoutSecondsOrDefault(20)),
            token);
    }

    private async Task ChangeAltitudeAsync(MissionBlock block, CancellationToken token)
    {
        var timeout = TimeSpan.FromSeconds(block.TimeoutSecondsOrDefault(30));
        var deadline = DateTimeOffset.UtcNow + timeout;
        var tolerance = block.ToleranceOrDefault(0.25);
        var speed = Math.Clamp(Math.Abs(block.Speed), 0.1, 1.0);

        try
        {
            while (DateTimeOffset.UtcNow < deadline)
            {
                token.ThrowIfCancellationRequested();
                await RefreshTelemetryAsync();

                var delta = block.Altitude - telemetry.AltitudeMeters;
                if (Math.Abs(delta) <= tolerance)
                {
                    return;
                }

                var vz = delta > 0 ? -speed : speed;
                await EnsureSuccess("Change altitude", Drone.SendVelocity(0, 0, vz, 0.35));
            }

            throw new TimeoutException($"Altitude target {block.Altitude:0.0}m not reached. Current altitude: {telemetry.AltitudeMeters:0.0}m.");
        }
        finally
        {
            if (isConnected)
            {
                await Drone.SendVelocity(0, 0, 0, 0.1);
            }
        }
    }

    private async Task WaitUntilAltitudeAsync(double targetAltitude, double tolerance, TimeSpan timeout, CancellationToken token)
    {
        await WaitUntilAsync(
            $"altitude {targetAltitude:0.0}m",
            () => Math.Abs(telemetry.AltitudeMeters - targetAltitude) <= tolerance,
            timeout,
            token);
    }

    private async Task WaitUntilLandedReadyAsync(CancellationToken token)
    {
        var deadline = DateTimeOffset.UtcNow + TimeSpan.FromSeconds(90);
        DateTimeOffset? stableSince = null;
        double? stableReferenceAltitude = null;

        while (DateTimeOffset.UtcNow < deadline)
        {
            token.ThrowIfCancellationRequested();
            await RefreshTelemetryAsync();
            await InvokeAsync(StateHasChanged);

            var inLandMode = string.Equals(telemetry.Mode, "LAND", StringComparison.OrdinalIgnoreCase);
            if (inLandMode)
            {
                if (stableReferenceAltitude is null || Math.Abs(telemetry.AltitudeMeters - stableReferenceAltitude.Value) > 0.05)
                {
                    stableReferenceAltitude = telemetry.AltitudeMeters;
                    stableSince = DateTimeOffset.UtcNow;
                }
                else if (stableSince is not null && DateTimeOffset.UtcNow - stableSince.Value >= TimeSpan.FromSeconds(3))
                {
                    if (telemetry.Armed)
                    {
                        await EnsureSuccess("Disarm after landing", Drone.Disarm());
                        await WaitUntilAsync("ready after landing", () => !telemetry.Armed, TimeSpan.FromSeconds(10), token);
                    }

                    missionGroundAltitude = stableReferenceAltitude.Value;
                    return;
                }
            }
            else
            {
                stableReferenceAltitude = null;
                stableSince = null;
            }

            if (telemetry.AltitudeMeters <= 0.2 && !telemetry.Armed)
            {
                missionGroundAltitude = telemetry.AltitudeMeters;
                return;
            }

            await Task.Delay(500, token);
        }

        throw new TimeoutException("Timed out while waiting for landed ready state.");
    }

    private async Task WaitUntilGpsTargetAsync(MissionBlock block, double targetAltitude, CancellationToken token)
    {
        await WaitUntilAsync(
            "GPS target",
            () =>
            {
                if (telemetry.Latitude is null || telemetry.Longitude is null)
                {
                    return false;
                }

                var distance = DistanceMeters(telemetry.Latitude.Value, telemetry.Longitude.Value, block.Latitude, block.Longitude);
                return distance <= Math.Max(0.5, block.Radius)
                    && Math.Abs(telemetry.AltitudeMeters - targetAltitude) <= 0.75;
            },
            TimeSpan.FromSeconds(block.TimeoutSecondsOrDefault(90)),
            token);
    }

    private async Task WaitUntilLocalTargetAsync(MissionBlock block, CancellationToken token)
    {
        await WaitUntilAsync(
            "local target",
            () =>
            {
                if (telemetry.LocalX is null || telemetry.LocalY is null)
                {
                    return false;
                }

                var distance = Math.Sqrt(Math.Pow(telemetry.LocalX.Value - block.LocalX, 2) + Math.Pow(telemetry.LocalY.Value - block.LocalY, 2));
                return distance <= Math.Max(0.25, block.Radius)
                    && Math.Abs(telemetry.AltitudeMeters - block.Altitude) <= 0.75;
            },
            TimeSpan.FromSeconds(block.TimeoutSecondsOrDefault(45)),
            token);
    }

    private async Task WaitUntilModeAsync(string mode, TimeSpan timeout, CancellationToken token)
    {
        await WaitUntilAsync(
            mode,
            () => string.Equals(telemetry.Mode, mode, StringComparison.OrdinalIgnoreCase),
            timeout,
            token);
    }

    private async Task WaitUntilAsync(string label, Func<bool> condition, TimeSpan timeout, CancellationToken token)
    {
        var deadline = DateTimeOffset.UtcNow + timeout;
        while (DateTimeOffset.UtcNow < deadline)
        {
            token.ThrowIfCancellationRequested();
            await RefreshTelemetryAsync();
            await InvokeAsync(StateHasChanged);

            if (condition())
            {
                return;
            }

            await Task.Delay(250, token);
        }

        throw new TimeoutException($"Timed out while waiting for {label}.");
    }

    private async Task DelayWithTelemetryAsync(TimeSpan delay, CancellationToken token)
    {
        var deadline = DateTimeOffset.UtcNow + delay;
        while (DateTimeOffset.UtcNow < deadline)
        {
            token.ThrowIfCancellationRequested();
            await RefreshTelemetryAsync();
            await Task.Delay(TimeSpan.FromMilliseconds(250), token);
        }
    }

    private async Task AbortMissionAsync()
    {
        missionCancellation?.Cancel();
        error = "";
        status = "Abort requested";
        runningBlockId = null;

        if (isConnected)
        {
            await Drone.SendVelocity(0, 0, 0, 0.1);
            await Drone.Land();
        }
    }

    private async Task EnsureSuccess(string label, Task<DroneApiService.ApiResponse<object>> action)
    {
        var result = await action;
        if (result.Success)
        {
            return;
        }

        throw new InvalidOperationException($"{label} failed: {CombineError(result.ErrorMessage, result.ResponseBody)}");
    }

    private static (double Vx, double Vy, double Vz) VelocityFor(FlightDirection direction, double speed)
    {
        var amount = Math.Clamp(speed, 0.0, 1.0);
        return direction switch
        {
            FlightDirection.Back => (-amount, 0, 0),
            FlightDirection.Left => (0, -amount, 0),
            FlightDirection.Right => (0, amount, 0),
            FlightDirection.Up => (0, 0, -amount),
            FlightDirection.Down => (0, 0, amount),
            _ => (amount, 0, 0),
        };
    }

    private async Task PollTelemetryAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));

        while (!token.IsCancellationRequested)
        {
            try
            {
                await RefreshTelemetryAsync();
                await InvokeAsync(StateHasChanged);
                await timer.WaitForNextTickAsync(token);
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch
            {
                await Task.Delay(1000, token);
            }
        }
    }

    private async Task RefreshTelemetryAsync()
    {
        try
        {
            var json = await Drone.GetStatus();
            telemetry = TelemetrySnapshot.FromJson(json);
            isConnected = telemetry.Connected;

            if (!isChangingMode
                && !string.IsNullOrWhiteSpace(telemetry.Mode)
                && selectableModes.Contains(telemetry.Mode, StringComparer.OrdinalIgnoreCase))
            {
                selectedMode = telemetry.Mode;
            }

            CaptureGpsTrailPoint();
            await UpdateRouteMapAsync(fitRoute: false);
        }
        catch
        {
            isConnected = false;
        }
    }

