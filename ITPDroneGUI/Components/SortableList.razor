@typeparam TItem
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="container" class="@ContainerClass" data-sortable-list="@listId">
    @if (Items.Count == 0 && EmptyContent is not null)
    {
        <div data-sortable-empty>
            @EmptyContent
        </div>
    }

    @foreach (var item in Items)
    {
        var key = ItemKey(item);
        <div @key="key" class="@ItemClass" data-sortable-item data-sortable-key="@key">
            @ItemTemplate(item)
        </div>
    }
</div>

@code {
    private readonly string listId = $"sortable-{Guid.NewGuid():N}";
    private ElementReference container;
    private DotNetObjectReference<SortableList<TItem>>? dotNetReference;
    private bool jsInitialized;

    [Parameter, EditorRequired]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    [Parameter, EditorRequired]
    public Func<TItem, string> ItemKey { get; set; } = _ => "";

    [Parameter, EditorRequired]
    public RenderFragment<TItem> ItemTemplate { get; set; } = default!;

    [Parameter]
    public RenderFragment? EmptyContent { get; set; }

    [Parameter]
    public EventCallback<SortableListMoveEventArgs> OnMove { get; set; }

    [Parameter]
    public EventCallback<SortableListExternalDropEventArgs> OnExternalDrop { get; set; }

    [Parameter]
    public string ContainerClass { get; set; } = "sortable-list";

    [Parameter]
    public string ItemClass { get; set; } = "sortable-item";

    [Parameter]
    public string PlaceholderClass { get; set; } = "sortable-placeholder";

    [Parameter]
    public string ExternalSelector { get; set; } = "[data-sortable-template-kind]";

    [Parameter]
    public string ExternalDataAttribute { get; set; } = "sortableTemplateKind";

    [Parameter]
    public bool Disabled { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        dotNetReference ??= DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync("droneForgeSortableList.initialize", container, dotNetReference, new
        {
            listId,
            disabled = Disabled,
            placeholderClass = PlaceholderClass,
            externalSelector = ExternalSelector,
            externalDataAttribute = ExternalDataAttribute,
        });

        jsInitialized = true;
    }

    [JSInvokable]
    public Task NotifyMove(string itemId, int oldIndex, int newIndex)
    {
        return OnMove.InvokeAsync(new SortableListMoveEventArgs
        {
            ItemId = itemId,
            OldIndex = oldIndex,
            NewIndex = newIndex,
        });
    }

    [JSInvokable]
    public Task NotifyExternalDrop(string payload, int newIndex)
    {
        return OnExternalDrop.InvokeAsync(new SortableListExternalDropEventArgs
        {
            Payload = payload,
            NewIndex = newIndex,
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (jsInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("droneForgeSortableList.dispose", container);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }

        dotNetReference?.Dispose();
    }
}
